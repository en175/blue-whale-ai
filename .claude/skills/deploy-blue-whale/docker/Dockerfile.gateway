# gateway 外置依赖打包：瘦 jar（manifest Class-Path 指向 lib/）+ lib/（依赖）+ config/（bootstrap.yml/logback）。
# lib/ config/ 由 push.sh 传到 build context 根（/opt/blue-whale/lib /opt/blue-whale/config）。
FROM docker.m.daocloud.io/library/eclipse-temurin:21-jre
WORKDIR /app
COPY jars/blue-whale-gateway.jar app.jar
COPY lib/ lib/
COPY config/ config/
EXPOSE 8686
ENTRYPOINT ["java", "-jar", "app.jar"]

