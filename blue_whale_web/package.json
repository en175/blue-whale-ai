{
  "name": "blue_whale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "design:lint": "designmd lint DESIGN.md",
    "design:diff": "designmd diff DESIGN.md DESIGN-v2.md",
    "design:export:tw": "designmd export --format css-tailwind DESIGN.md",
    "design:spec": "designmd spec --rules"
  },
  "lint-staged": {
    "blue_whale_web/**/*.{ts,tsx,js,jsx,mjs}": [
      "prettier --config blue_whale_web/.prettierrc --write",
      "eslint --config blue_whale_web/eslint.config.mjs --fix"
    ],
    "blue_whale_web/**/*.{css,md,json}": [
      "prettier --config blue_whale_web/.prettierrc --write"
    ]
  },
  "dependencies": {
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@google/design.md": "^0.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
