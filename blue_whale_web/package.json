{
  "name": "blue_whale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --dir .. build:node && pnpm build:worker",
    "dev": "node --env-file-if-exists=../.env ../scripts/dev-blue-whale.mjs",
    "predev:lan": "pnpm --dir .. build:node && pnpm build:worker",
    "dev:lan": "node --env-file-if-exists=../.env ../scripts/dev-blue-whale.mjs --lan",
    "build": "next build && pnpm build:worker",
    "build:worker": "esbuild workers/generation-worker.ts --bundle --platform=node --format=esm --outfile=.worker-dist/generation-worker.mjs",
    "start": "next start",
    "start:worker": "node .worker-dist/generation-worker.mjs",
    "start:lan": "next start -H 0.0.0.0",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:fullstack": "bash ../scripts/run-mvp-acceptance.sh",
    "design:lint": "designmd lint DESIGN.md",
    "design:diff": "designmd diff DESIGN.md DESIGN-v2.md",
    "design:export:tw": "designmd export --format css-tailwind DESIGN.md",
    "design:spec": "designmd spec --rules"
  },
  "lint-staged": {
    "blue_whale_web/**/*.{ts,tsx,js,jsx,mjs}": [
      "prettier --config blue_whale_web/.prettierrc --write",
      "eslint --config blue_whale_web/eslint.config.mjs --fix"
    ],
    "blue_whale_web/**/*.{css,md,json}": [
      "prettier --config blue_whale_web/.prettierrc --write"
    ]
  },
  "dependencies": {
    "@blue-whale/contracts": "workspace:*",
    "@blue-whale/core": "workspace:*",
    "@blue-whale/generation-runtime": "workspace:*",
    "@blue-whale/persistence": "workspace:*",
    "@tiptap/extension-mention": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@volcengine/tos-sdk": "^2.9.1",
    "@xyflow/react": "^12.11.2",
    "bullmq": "^5.81.2",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.5",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@google/design.md": "^0.3.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.5.2",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
