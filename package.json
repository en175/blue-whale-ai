{
  "name": "blue-whale-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "pnpm build:node && pnpm --filter blue_whale build",
    "build:node": "tsc -b --pretty false",
    "typecheck": "tsc -b --force --pretty false && pnpm --filter blue_whale exec tsc --noEmit",
    "test": "pnpm test:node && pnpm --filter blue_whale test",
    "test:node": "vitest run packages && pnpm test:acceptance-runner-contract",
    "test:acceptance-runner-contract": "node --test tests/typescript-baseline/acceptance-runner-contract.test.mjs",
    "db:fresh": "bash scripts/init-typescript-baseline-db.sh",
    "test:acceptance": "bash scripts/run-typescript-baseline-acceptance.sh",
    "verify": "bash scripts/verify-typescript-baseline.sh"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "playwright": "^1.48.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
