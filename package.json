{
  "name": "blue-whale-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "pnpm build:node && pnpm --dir backend build",
    "build:node": "tsc -b --pretty false",
    "typecheck": "pnpm --filter @blue-whale/backend exec prisma generate && tsc -b --force --pretty false",
    "lint": "pnpm lint:node",
    "lint:node": "eslint packages",
    "test": "pnpm test:node",
    "test:node": "pnpm test:unit",
    "test:unit": "vitest run packages",
    "test:backend": "vitest run backend",
    "test:ci": "pnpm test:unit",
    "verify": "bash scripts/verify-typescript-baseline.sh"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.48.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "2.1.9"
  }
}
