  @@index([token], map: "idx_token")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model generation_jobs {
  id                       BigInt    @id @default(autoincrement())
  project_id               BigInt?
  user_id                  BigInt
  agent_run_id             BigInt?
  action_identity          String?   @db.VarChar(128)
  project_action_identity  String?   @db.VarChar(128)
  expected_output_count    Int       @default(1)
  retry_of_job_id          BigInt?
  type                     String    @db.VarChar(32)
  source                   String    @default("dock") @db.VarChar(32)
  status                   String    @default("queued") @db.VarChar(32)
  progress                 Int       @default(0)
  output_asset_ids         Json?
  provider                 String?   @db.VarChar(64)
  provider_task_id         String?   @db.VarChar(128)
  poll_count               Int       @default(0)
  next_poll_at             DateTime? @db.DateTime(0)
  retry_count              Int       @default(0)
  last_polled_at           DateTime? @db.DateTime(0)
  error                    Json?
  stage_id                 String?   @db.VarChar(64)
  lease_owner              String?   @db.VarChar(128)
  lease_expires_at         DateTime? @db.DateTime(0)
  fencing_token            BigInt    @default(0)
  strategy_version         String?   @db.VarChar(64)
  execution_deadline_at    DateTime? @db.DateTime(0)
  evidence_reconcile_until DateTime? @db.DateTime(0)
  next_action_at           DateTime? @db.DateTime(0)
  cancel_requested_at      DateTime? @db.DateTime(0)
  gmt_create               DateTime  @default(now()) @db.DateTime(0)
  gmt_modified             DateTime  @default(now()) @db.DateTime(0)
  version                  Int       @default(0)
  is_delete                Boolean   @default(false)
  input                    Json?

  @@index([project_id], map: "idx_project_id")
  @@index([provider_task_id], map: "idx_provider_task_id")
  @@index([status, next_poll_at], map: "idx_status_next_poll")
  @@index([user_id], map: "idx_user_id")
  @@index([next_action_at], map: "idx_generation_next_action")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model generation_model_capability {
  id                      BigInt   @id @default(autoincrement())
