generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model api_key {
  id            BigInt   @id @default(autoincrement())
  user_id       BigInt
  name          String   @default("") @db.VarChar(128)
  consumer_name String   @unique(map: "uk_consumer_name") @default("") @db.VarChar(64)
  key_prefix    String   @default("") @db.VarChar(32)
  key_hash      String   @unique(map: "uk_key_hash") @db.VarChar(128)
  status        String   @default("ACTIVE") @db.VarChar(32)
  token_quota   BigInt?
  remark        String?  @db.VarChar(255)
  gmt_create    DateTime @default(now()) @db.DateTime(0)
  gmt_modified  DateTime @default(now()) @db.DateTime(0)
  version       Int      @default(0)
  is_delete     Int      @default(0) @db.TinyInt

  @@index([user_id], map: "idx_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model api_key_usage {
  id            BigInt   @id @default(autoincrement())
  api_key_id    BigInt
  user_id       BigInt
  model         String?  @db.VarChar(64)
  provider      String?  @db.VarChar(64)
  input_tokens  BigInt   @default(0)
  output_tokens BigInt   @default(0)
  request_id    String   @unique(map: "uk_request_id") @db.VarChar(64)
  gmt_create    DateTime @default(now()) @db.DateTime(0)
  gmt_modified  DateTime @default(now()) @db.DateTime(0)
  version       Int      @default(0)
  is_delete     Int      @default(0) @db.TinyInt

  @@index([api_key_id], map: "idx_api_key_id")
  @@index([user_id], map: "idx_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model assets {
  id                BigInt   @id @default(autoincrement())
  user_id           BigInt
  project_id        BigInt   @default(0)
  generation_job_id BigInt?
  type              String   @db.VarChar(16)
  storage_key       String?  @db.VarChar(512)
  content_sha256    String?  @db.VarChar(64)
  url               String   @db.VarChar(512)
  mime              String?  @db.VarChar(64)
  size              BigInt?
  width             Int?
  height            Int?
  duration          Int?
  duration_ms       Int?
  source            String   @default("generated") @db.VarChar(32)
  status            String   @default("normal") @db.VarChar(32)
  gmt_create        DateTime @default(now()) @db.DateTime(0)
  gmt_modified      DateTime @default(now()) @db.DateTime(0)
  version           Int      @default(0)
  is_delete         Boolean  @default(false)

  @@index([project_id], map: "idx_asset_project")
  @@index([project_id, type], map: "idx_asset_project_type")
  @@index([generation_job_id], map: "idx_asset_generation_job")
  @@index([type], map: "idx_type")
  @@index([user_id], map: "idx_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model canvas {
  id            BigInt   @id @default(autoincrement())
