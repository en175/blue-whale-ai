/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model user_skill {
  id           BigInt   @id @default(autoincrement())
  user_id      BigInt
  skill_id     BigInt
  auto         Int      @default(0) @db.TinyInt
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  version      Int      @default(0)
  is_delete    Int      @default(0) @db.TinyInt

  @@unique([user_id, skill_id], map: "uk_user_skill")
  @@index([skill_id], map: "idx_skill")
  @@index([user_id], map: "idx_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id           BigInt   @id @default(autoincrement())
  phone        String   @unique(map: "idx_phone") @db.VarChar(20)
  username     String   @db.VarChar(50)
  status       String   @default("NORMAL") @db.VarChar(30)
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  version      Int      @default(1)
  is_delete    Boolean  @default(false)
  avatar       String?  @default("0") @db.VarChar(255)
  password     String?  @db.VarChar(63)
}

model verification_codes {
  id         BigInt   @id @default(autoincrement())
  phone      String   @db.VarChar(20)
  code       String   @db.VarChar(6)
  ip         String   @db.VarChar(50)
  gmt_expire DateTime @db.DateTime(0)
  is_used    Boolean  @default(false)
  gmt_create DateTime @default(now()) @db.DateTime(0)

  @@index([ip, gmt_create], map: "idx_ip_created")
  @@index([phone, gmt_create], map: "idx_phone_created")
  @@index([phone, is_used, gmt_expire], map: "idx_phone_unused")
}

// ===== 生成子系统（简化版，Node 自有 worker）：流水 + 日志 + 素材关联 + 点数 =====

model cost_reservations {
  id                    BigInt   @id @default(autoincrement())
  generation_job_id     BigInt
  user_id               BigInt
  project_id            BigInt
  action_identity       String   @db.VarChar(128)
  action_type           String   @db.VarChar(64)
  provider              String   @db.VarChar(64)
  reserved_amount_fen   BigInt
  actual_amount_fen     BigInt?
  status                String   @db.VarChar(32)
  price_catalog_version String   @db.VarChar(64)
  exchange_rate_version String   @db.VarChar(64)
  model_policy_version  String   @db.VarChar(64)
  cost_rule_version     String   @db.VarChar(64)
  gmt_create            DateTime @default(now()) @db.DateTime(0)
  gmt_modified          DateTime @default(now()) @db.DateTime(0)
  version               Int      @default(0)
  is_delete             Int      @default(0) @db.TinyInt

  @@unique([generation_job_id], map: "uk_cost_reservation_job")
}

/// 生成任务操作日志（append-only，追溯还原）：每次状态变更 / provider 调用记一行。
model generation_job_logs {
  id                BigInt   @id @default(autoincrement())
  generation_job_id BigInt
  event             String   @db.VarChar(64)
  status            String?  @db.VarChar(32)
  payload           Json?
  message           String?  @db.Text
  occurred_at       DateTime @default(now()) @db.DateTime(0)

  @@index([generation_job_id, occurred_at], map: "idx_gen_job_log_job_time")
}
