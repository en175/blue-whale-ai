{
  "name": "blue_whale_web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:test": "vite --mode test",
    "release": "vite --mode release",
    "build:dev": "tsc -b && vite build --mode development",
    "build:test": "tsc -b && vite build --mode test",
    "build:release": "tsc -b && vite build --mode release",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:bugfix": "npm run lint && npm test && npm run build:release",
    "smoke:bugfix": "node scripts/run-bugfix-smoke.mjs",
    "check:agent-routes": "node scripts/check-agent-routes.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@icon-park/react": "^1.4.2",
    "@lexical/react": "^0.49.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-query": "^5.102.8",
    "@xyflow/react": "^12.11.2",
    "dayjs": "1.11.23",
    "dompurify": "^3.4.14",
    "lexical": "^0.49.0",
    "lucide-react": "^1.31.0",
    "masonic": "4.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "2.1.9"
  }
}
