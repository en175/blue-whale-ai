# 生产环境（npm run release / build:release）
VITE_APP_ENV=production
# 生产环境接口域名

# VITE_API_BASE_URL=http://192.168.10.28:3100

VITE_API_BASE_URL=https://web.release.xfai.cloud

# 侧边栏 Agent 数据源：0 = 走真实 /api/agent/v1（经 BFF 代理到独立 agent 服务）
# 严格等于字符串 '0' 才生效，写 false / 1 / 不写都会回落到 mock。
# 这是构建期变量，由 Vite 静态替换进产物；运行时给容器塞环境变量无效。
VITE_AGENT_MOCK=0
