/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model generation_jobs {
  id                       BigInt    @id @default(autoincrement())
  project_id               BigInt?
  user_id                  BigInt
  agent_run_id             BigInt?
  action_identity          String?   @db.VarChar(128)
  project_action_identity  String?   @db.VarChar(128)
  expected_output_count    Int       @default(1)
  retry_of_job_id          BigInt?
  type                     String    @db.VarChar(32)
  source                   String    @default("dock") @db.VarChar(32)
  status                   String    @default("queued") @db.VarChar(32)
  progress                 Int       @default(0)
  output_asset_ids         Json?
  provider                 String?   @db.VarChar(64)
  provider_task_id         String?   @db.VarChar(128)
  poll_count               Int       @default(0)
  next_poll_at             DateTime? @db.DateTime(0)
  retry_count              Int       @default(0)
  last_polled_at           DateTime? @db.DateTime(0)
  error                    Json?
  stage_id                 String?   @db.VarChar(64)
  lease_owner              String?   @db.VarChar(128)
  lease_expires_at         DateTime? @db.DateTime(0)
  fencing_token            BigInt    @default(0)
  strategy_version         String?   @db.VarChar(64)
  execution_deadline_at    DateTime? @db.DateTime(0)
  evidence_reconcile_until DateTime? @db.DateTime(0)
  next_action_at           DateTime? @db.DateTime(0)
  cancel_requested_at      DateTime? @db.DateTime(0)
  gmt_create               DateTime  @default(now()) @db.DateTime(0)
  gmt_modified             DateTime  @default(now()) @db.DateTime(0)
  version                  Int       @default(0)
  is_delete                Boolean   @default(false)
  canvas_card_state        String    @default("pending") @db.VarChar(16)
  input                    Json?

  @@index([project_id], map: "idx_project_id")
  @@index([provider_task_id], map: "idx_provider_task_id")
  @@index([status, next_poll_at], map: "idx_status_next_poll")
  @@index([user_id], map: "idx_user_id")
  @@index([next_action_at], map: "idx_generation_next_action")
  /// 仪表盘区间统计：WHERE is_delete = 0 AND gmt_create ∈ [from, to)。
  /// `is_delete` 在前做等值前缀、`gmt_create` 走区间 —— 反过来放会让等值条件退化成过滤。
  @@index([is_delete, gmt_create], map: "idx_generation_jobs__is_delete_gmt_create")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model generation_model_capability {
  id                      BigInt   @id @default(autoincrement())
  provider_id             String   @db.VarChar(32)
  model_id                String   @db.VarChar(128)
  capability_type         String   @db.VarChar(16)
  model_label             String   @db.VarChar(64)
  icon                    String?  @db.VarChar(512)
  supported_sizes         Json
  supported_aspect_ratios Json
  supported_durations     Json?
  supported_formats       Json
  default_size            String   @db.VarChar(32)
  default_format          String?  @db.VarChar(16)
  default_aspect_ratio    String   @db.VarChar(16)
  default_duration        Int?
  features                Json
  /// 渠道（`<家族>-<媒介>[-<协议>]`，**封闭枚举**）：这个模型走哪个渠道 ——
  /// 决定请求怎么解析、出站用哪种线协议。**本行解析与出站行为的唯一来源**。
  /// 取代了 `channel_parser`（列）与 `features.image_protocol`（JSON 键）—— 那两个已被
  /// 040 迁移删掉/清空，代码里也没有读方了。
  channel                 String   @db.VarChar(32)
  request_mapping         Json?
  /// 该模型该能力的计价规则，JSON 形态与定价目录 `document.models.<model_id>.<capability_type>`
  /// 那条逐字相同（baseUnit / basePrice{kind,value?,by?,table?} / unitDenominator / minCredits /
  /// maxCredits? / rounding? / dims? / multipliers? / tokenEstimate?）。
  /// 原住 billing 的 `billing_pricing_catalogs.document`，因「它本质上是模型的属性」而搬来；
  /// billing 生成任务时随 Hold 请求带走并存进自己的预留行，结算用预留行快照，故不反查本库。
  /// 过渡期可为 NULL = 尚未搬迁，billing 侧回落定价目录。
  pricing                 Json?
  enabled                 Boolean  @default(true)
  sort_order              Int      @default(0)
  is_default              Boolean  @default(false)
  gmt_create              DateTime @default(now()) @db.DateTime(0)
  gmt_modified            DateTime @default(now()) @db.DateTime(0)
  version                 Int      @default(0)
  is_delete               Boolean  @default(false)

  @@unique([provider_id, model_id], map: "uk_provider_model")
  @@index([capability_type, enabled], map: "idx_capability_type_enabled")
}

