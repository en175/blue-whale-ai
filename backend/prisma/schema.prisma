  @@unique([user_id, asset_id, project_id], map: "uk_project_asset")
  @@index([user_id, project_id], map: "idx_pa_user_project")
  @@index([asset_id], map: "idx_pa_asset")
  @@index([project_id], map: "idx_pa_project")
}

