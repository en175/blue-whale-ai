  @@index([project_id], map: "idx_scene_card_project")
}

/// 旧内嵌 Agent 引擎运行表（已退役，IKCKOW 保留）：支撑「个人技能删除时进行中引用禁删」
/// 保护（SkillInUseError + run_pin scrub，见 skill-repo deletePersonal），不再有写入方。
model agent_runs {
  id                                BigInt    @id @default(autoincrement())
  project_id                        BigInt
  conversation_id                   BigInt
  active_guard                      BigInt?   @unique(map: "uk_agent_run_active_guard")
  user_id                           BigInt
  status                            String    @db.VarChar(32)
  stage                             String?   @db.VarChar(32)
  engine                            String    @db.VarChar(64)
  engine_version                    String    @db.VarChar(64)
  adapter_schema_version            Int
  input_sequence_no                 Int       @default(0)
  lease_owner                       String?   @db.VarChar(128)
  lease_expires_at                  DateTime? @db.DateTime(0)
  fencing_token                     BigInt    @default(0)
  terminal_reason                   String?   @db.VarChar(64)
  failure_code                      String?   @db.VarChar(128)
  failure_message                   String?   @db.Text
  /// 手动重试计数（IK67GZ，契约 §8.3）：每次用户重试 failed→queued 递增。
  retry_count                       Int       @default(0)
  run_pin                           Json?
  activated_creative_skill_versions Json?
  reasoning_summary                 String?   @db.VarChar(280)
  gmt_create                        DateTime  @default(now()) @db.DateTime(0)
  gmt_modified                      DateTime  @default(now()) @db.DateTime(0)
  version                           Int       @default(0)
  is_delete                         Int       @default(0) @db.TinyInt

  @@index([project_id, status], map: "idx_agent_run_project_status")
  @@index([status, engine, is_delete, id], map: "idx_agent_run_claim")
}

/// 计划卡冻结态（IK67H6，契约 §9）：与 conversation_messages(content_type=plan_message) 1:1，
/// 存不可变权威 Markdown、按首次出现去重的素材引用、完整生成参数、能力快照版本、ProviderPromptProjection 与序列标签。
/// 手动应用（创建 SceneCard / GenerationJob）由 T10/T11 交付，本票只冻结不应用。
model plan_messages {
  id                           BigInt   @id @default(autoincrement())
  message_id                   BigInt   @unique(map: "uk_plan_message_message")
  conversation_id              BigInt
  project_id                   BigInt
  agent_run_id                 BigInt
  ordinal                      Int
  total_in_batch               Int
  sequence_label               String?  @db.VarChar(255)
  application_kind             String   @db.VarChar(32)
  target_scene_card_mention_id BigInt?
  base_scene_card_version      Int?
  content_markdown             String   @db.LongText
  derived_references           Json
  frozen_generation_parameters Json
  capability_snapshot_version  Json
  provider_prompt_projection   Json
  base_plan_message_id         BigInt?
  source_plan_message_id       BigInt?
  applied_at                   DateTime? @db.DateTime(0)
  first_generation_job_id      BigInt?
  gmt_create                   DateTime @default(now()) @db.DateTime(0)

  @@index([project_id], map: "idx_plan_message_project")
  @@index([agent_run_id], map: "idx_plan_message_agent_run")
  @@index([application_kind], map: "idx_plan_message_application_kind")
}

