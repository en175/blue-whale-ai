/// IKCNLP（方案C）：素材-项目关联（1 素材可跨多项目）。
/// 画布使用素材时建立；snapshot.assets 按本项目关联 + 直接归属本项目(project_id=pid)的素材返回。
model project_asset {
  id           BigInt   @id @default(autoincrement())
  user_id      BigInt
  asset_id     BigInt
  project_id   BigInt
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  is_delete    Int      @default(0) @db.TinyInt

  @@unique([user_id, asset_id, project_id], map: "uk_project_asset")
  @@index([user_id, project_id], map: "idx_pa_user_project")
  @@index([asset_id], map: "idx_pa_asset")
  @@index([project_id], map: "idx_pa_project")
}

