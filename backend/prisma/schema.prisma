  is_builtin   Boolean  @default(false)
  sort_order   Int      @default(0)
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  version      Int      @default(0)
  is_delete    Boolean  @default(false)

  @@unique([code], map: "uk_bw_roles__code")
}

/// 用户 ↔ 角色（bw_user_roles）。存 role_id 而非 code：角色改名只改一行，
/// 不散落成几十条待更新的关联行。
model bw_user_roles {
  id           BigInt   @id @default(autoincrement())
  user_id      BigInt
  role_id      BigInt
  granted_by   String   @default("system") @db.VarChar(64)
  grant_key    String   @db.VarChar(190)
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  version      Int      @default(0)
  is_delete    Boolean  @default(false)

  @@unique([grant_key], map: "uk_bw_user_roles__grant_key")
  @@index([user_id, is_delete], map: "idx_bw_user_roles__user")
}

/// 登录日志（bw_login_logs）。`user_id` 可空——登录失败时用户可能压根不存在，
/// 而这些恰恰是最需要留痕的尝试。
model bw_login_logs {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt?
  username   String   @db.VarChar(50)
  ip         String   @db.VarChar(50)
  user_agent String   @default("") @db.VarChar(255)
  success    Boolean
  reason     String   @default("") @db.VarChar(64)
  gmt_create DateTime @default(now()) @db.DateTime(0)

  @@index([user_id, gmt_create], map: "idx_bw_login_logs__user_time")
  @@index([ip, gmt_create], map: "idx_bw_login_logs__ip_time")
}
