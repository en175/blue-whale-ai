  /// 到账积分有效期，单位**月**（默认 2 年 = 24 个月）。口径钉死为月，年表达不了 6/18 个月
  credits_valid_months     Int     @default(24)
  /// all 全部登录用户 | user_group 指定用户群 | member_tier 指定会员等级（阶段 2 生效，先占位）
  permission               String  @default("all") @db.VarChar(16)
