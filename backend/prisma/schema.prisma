/// IK764F：首页模板标签（原硬编码枚举落库）。tag_code 与顺序固定，仅 label 可由管理后台改名。
model template_tag {
  id           BigInt   @id @default(autoincrement())
  tag_code     String   @db.VarChar(64)
  label        String   @db.VarChar(128)
  sort_order   Int      @default(0)
  visible      Int      @default(1) @db.TinyInt
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  is_delete    Int      @default(0) @db.TinyInt

  @@unique([tag_code], map: "uk_tag_code")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model user_skill {
  id           BigInt   @id @default(autoincrement())
  user_id      BigInt
  skill_id     BigInt
  auto         Int      @default(0) @db.TinyInt
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  version      Int      @default(0)
  is_delete    Int      @default(0) @db.TinyInt

  @@unique([user_id, skill_id], map: "uk_user_skill")
  @@index([skill_id], map: "idx_skill")
  @@index([user_id], map: "idx_user")
}

/// IKCH05：首页背景图/视频后台动态配置条目。media_type=video 时 poster_url 必填；
/// enabled=1 进首页轮播（按 sort_order 升序）；上限 8 条（应用层校验，不设 DB 唯一约束）。
model homepage_hero {
  id           BigInt   @id @default(autoincrement())
  media_type   String   @default("video") @db.VarChar(16) // image | video
  media_url    String   @db.VarChar(512) // 视频/图片 URL（TOS 迁移中可暂空）
  poster_url   String?  @db.VarChar(512) // 视频封面；media_type=video 必填
  sort_order   Int      @default(0)
  enabled      Int      @default(1) @db.TinyInt // 1 进轮播 / 0 停用
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  version      Int      @default(0)
  is_delete    Int      @default(0) @db.TinyInt

  @@index([enabled, is_delete, sort_order], map: "idx_hero_enabled_sort")
  @@index([sort_order, is_delete], map: "idx_hero_sort")
}

/// Creative Skill 稳定身份（IK60WS，资产契约 §1）：官方与个人共用一表；
/// owner_user_id=0 表示平台官方资产，asset_domain 区分 official/personal。
model creative_skill {
  id                BigInt   @id @default(autoincrement())
  creative_skill_id String   @unique(map: "uk_creative_skill_id") @db.VarChar(80)
  name              String   @db.VarChar(255)
  description       String?  @db.VarChar(1000)
  source_skill_id   BigInt?
  active_version_id String?  @db.VarChar(80)
  owner_user_id     BigInt   @default(0)
  asset_domain      String   @default("official") @db.VarChar(16)
  name_key          String?  @db.VarChar(255)
  auto_match        Int      @default(0)
  gmt_create        DateTime @default(now()) @db.DateTime(0)
  gmt_modified      DateTime @default(now()) @db.DateTime(0)

  @@index([owner_user_id, asset_domain], map: "idx_owner_domain")
  @@index([owner_user_id, name_key], map: "idx_owner_name_key")
}

/// Creative Skill 不可变版本快照（IK60WS，资产契约 §1）：
/// body 为剥掉 frontmatter 的纯正文，digest=sha256(body)，仅受信任运行时按 pin 读取。
model creative_skill_version {
  id                        BigInt   @id @default(autoincrement())
  creative_skill_version_id String   @unique(map: "uk_creative_skill_version_id") @db.VarChar(80)
  creative_skill_id         String   @db.VarChar(80)
  display_version           String   @db.VarChar(64)
  body                      String   @db.LongText
  content_digest            String   @db.VarChar(71)
  resource_digest           String   @db.VarChar(71)
  media_type                String   @default("text/markdown") @db.VarChar(128)
  gmt_create                DateTime @default(now()) @db.DateTime(0)
  gmt_modified              DateTime @default(now()) @db.DateTime(0)

  @@unique([creative_skill_id, display_version], map: "uk_creative_skill_version_semver")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id           BigInt   @id @default(autoincrement())
  phone        String   @unique(map: "idx_phone") @db.VarChar(20)
  username     String   @db.VarChar(50)
  status       String   @default("NORMAL") @db.VarChar(30)
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  version      Int      @default(1)
  is_delete    Boolean  @default(false)
  avatar       String?  @default("0") @db.VarChar(255)
  password     String?  @db.VarChar(63)
}

model verification_codes {
  id         BigInt   @id @default(autoincrement())
  phone      String   @db.VarChar(20)
  code       String   @db.VarChar(6)
  ip         String   @db.VarChar(50)
  gmt_expire DateTime @db.DateTime(0)
  is_used    Boolean  @default(false)
  gmt_create DateTime @default(now()) @db.DateTime(0)

  @@index([ip, gmt_create], map: "idx_ip_created")
  @@index([phone, gmt_create], map: "idx_phone_created")
  @@index([phone, is_used, gmt_expire], map: "idx_phone_unused")
}

// ===== 充值档位（blue_whale 侧 CRUD，支付执行走 Go new-api） =====

model topup_tiers {
  id             BigInt    @id @default(autoincrement())
  name           String    @default("") @db.VarChar(100)
  amount         BigInt
  original_price Decimal   @db.Decimal(10, 2)
  discount       Decimal   @default(1) @db.Decimal(5, 4)
  price          Decimal   @db.Decimal(10, 2)
  is_recommended Boolean   @default(false)
  status         String    @default("active") @db.VarChar(16)
  start_time     DateTime? @db.DateTime(0)
  end_time       DateTime? @db.DateTime(0)
  sort_order     Int       @default(0)
  gmt_create     DateTime  @default(now()) @db.DateTime(0)
  gmt_modified   DateTime  @default(now()) @db.DateTime(0)
  version        Int       @default(0)
  is_delete      Int       @default(0) @db.TinyInt

  @@index([status, sort_order], map: "idx_tier_status_sort")
}

// ===== 管理后台操作审计（blue_whale 侧，记录管理变更操作；只记写操作，查询不记） =====

model admin_operation_logs {
  id             BigInt   @id @default(autoincrement())
  category       String   @default("") @db.VarChar(32)
  action         String   @db.VarChar(64)
  target         String   @default("") @db.VarChar(255)
  target_user_id BigInt?
  detail         String   @db.Text
  operator       String   @default("") @db.VarChar(64)
  operator_id    BigInt?
  ip_address     String?  @db.VarChar(64)
  gmt_create     DateTime @default(now()) @db.DateTime(0)
  gmt_modified   DateTime @default(now()) @db.DateTime(0)
  version        Int      @default(0)
  is_delete      Int      @default(0) @db.TinyInt

  @@index([category, gmt_create], map: "idx_oplog_category_created")
}

// ===== 生成子系统（简化版，Node 自有 worker）：流水 + 日志 + 素材关联 + 点数 =====

model cost_reservations {
  id                    BigInt   @id @default(autoincrement())
  generation_job_id     BigInt
  user_id               BigInt
  project_id            BigInt
  action_identity       String   @db.VarChar(128)
  action_type           String   @db.VarChar(64)
  provider              String   @db.VarChar(64)
  reserved_amount_fen   BigInt
  actual_amount_fen     BigInt?
  status                String   @db.VarChar(32)
  /** IK9VZ0：释放原因/退款校验结果（如 "refund_confirmed" 已确认无扣费 / "refund_unverified" 未校验或可能已扣）。 */
  release_note          String?  @db.VarChar(255)
  price_catalog_version String   @db.VarChar(64)
  exchange_rate_version String   @db.VarChar(64)
  model_policy_version  String   @db.VarChar(64)
  cost_rule_version     String   @db.VarChar(64)
  gmt_create            DateTime @default(now()) @db.DateTime(0)
  gmt_modified          DateTime @default(now()) @db.DateTime(0)
  version               Int      @default(0)
  is_delete             Int      @default(0) @db.TinyInt

  @@unique([generation_job_id], map: "uk_cost_reservation_job")
}

/// IK9VZ0：多退少补结算审计（蓝鲸端只记账，执行在 new-api）：new-api 结算结果的接收记录。
/// 幂等：batch_no 整批唯一（uk_adj_batch）；(generation_job_id, action_type) 单项唯一（uk_adj_job_action，
/// 仅对有 job 归属的调整生效；MySQL 唯一索引对 NULL 不生效，无 job 的调整靠整批幂等兜底）。
model cost_adjustments {
  id                BigInt   @id @default(autoincrement())
  batch_no          String   @db.VarChar(64)
  generation_job_id BigInt?
  user_id           BigInt
  project_id        BigInt?
  action_type       String   @db.VarChar(32) // "refund" | "supplement"（退/补）
  amount_fen        BigInt
  reason            String   @db.VarChar(255)
  status            String   @db.VarChar(32) // "applied" | "duplicate"
  new_api_snapshot  String?  @db.Text
  gmt_create        DateTime @default(now()) @db.DateTime(0)
  gmt_modified      DateTime @default(now()) @db.DateTime(0)
  version           Int      @default(0)
  is_delete         Int      @default(0) @db.TinyInt

  @@unique([batch_no], map: "uk_adj_batch")
  @@unique([generation_job_id, action_type], map: "uk_adj_job_action")
}

/// 生成任务操作日志（append-only，追溯还原）：每次状态变更 / provider 调用记一行。
model generation_job_logs {
  id                BigInt   @id @default(autoincrement())
  generation_job_id BigInt
  event             String   @db.VarChar(64)
  status            String?  @db.VarChar(32)
  payload           Json?
  message           String?  @db.Text
  occurred_at       DateTime @default(now()) @db.DateTime(0)

  @@index([generation_job_id, occurred_at], map: "idx_gen_job_log_job_time")
}

/// 计划应用回执（IK67H9/IK67H8，契约 §9 / CONTEXT L217-221）：一次成功应用 PlanMessage 的不可变事实。
/// 视频路径记 scene_card_id/结果版本/预设摘要；图片路径 scene_card_id 为 NULL 并记会话/运行归属。
/// uk_plan_application_receipt_message 兜底「每条 PlanMessage 最多一次成功应用」（CONTEXT L227）。
model plan_application_receipts {
  id                         BigInt   @id @default(autoincrement())
  message_id                 BigInt   @unique(map: "uk_plan_application_receipt_message")
  project_id                 BigInt
  conversation_id            BigInt?
  agent_run_id               BigInt?
  application_kind           String   @db.VarChar(32)
  scene_card_id              BigInt?
  first_generation_job_id    BigInt
  command_id                 String   @db.VarChar(128)
  content_digest             String   @db.VarChar(80)
  result_version             Int?
  preset_digest              String?  @db.VarChar(80)
  target_scene_card_mention_id BigInt?
  applied_at                 DateTime @db.DateTime(0)
  gmt_create                 DateTime @default(now()) @db.DateTime(0)

  @@unique([project_id, command_id], map: "uk_plan_application_command")
  @@index([first_generation_job_id], map: "idx_plan_application_job")
}

/// 场景卡生成预设（IK67H9，CONTEXT L49-58）：SceneCard 1:1 持久拥有的视频生成参数，
/// 首次应用从 PlanMessage 冻结参数创建。必有时长与视频参考模式；首/尾帧角色存 reference_assets。
model scene_card_generation_presets {
  id                          BigInt   @id @default(autoincrement())
  scene_card_id               BigInt   @unique(map: "uk_preset_scene")
  project_id                  BigInt
  parameters                  Json
  reference_mode              String   @db.VarChar(32)
  reference_assets            Json
  capability_snapshot_version Json
  gmt_create                  DateTime @default(now()) @db.DateTime(0)
  gmt_modified                DateTime @default(now()) @db.DateTime(0)
  version                     Int      @default(1)
  is_delete                   Int      @default(0) @db.TinyInt

  @@index([project_id], map: "idx_preset_project")
}

/// 场景卡生成记录（IK67H9，CONTEXT L82-86）：User 从 SceneCard 发起的一次新生成及重试的聚合。
/// summary_status 四态：generating/partial/success/failed。来源指向 plan_message 与应用回执。
model scene_card_generation_records {
  id                      BigInt   @id @default(autoincrement())
  scene_card_id           BigInt
  project_id              BigInt
  summary_status          String   @db.VarChar(16)
  plan_message_id         BigInt
  application_receipt_id  BigInt
  first_generation_job_id BigInt
  gmt_create              DateTime @default(now()) @db.DateTime(0)
  gmt_modified            DateTime @default(now()) @db.DateTime(0)
  version                 Int      @default(1)
  is_delete               Int      @default(0) @db.TinyInt

  @@index([scene_card_id], map: "idx_record_scene")
  @@index([project_id], map: "idx_record_project")
  @@index([summary_status], map: "idx_record_status")
}

/// 生成输出槽位（IK67HE/T14，spec §4.4 / ADR-0026）：每次生成在提交时固定数量的槽，
/// 身份与顺序稳定（slot_index）。成功 Asset 永久占据原槽；重试只补 failed/missing 槽，
/// 不覆盖成功输出。scene_card_generation_record_id 关联 SceneCard 视频聚合（视频路径）；
/// 图片路径留空。retry_of_slot_id 指向被重试的原始槽，形成同槽位重试链。
model generation_output_slots {
  id                              BigInt   @id @default(autoincrement())
  project_id                      BigInt
  generation_job_id               BigInt
  scene_card_generation_record_id BigInt?
  slot_index                      Int
  status                          String   @db.VarChar(24) // pending/succeeded/failed/missing
  asset_id                        BigInt?
  retry_of_slot_id                BigInt?
  initial_placement_status        String   @default("pending") @db.VarChar(16) // pending/placed
  gmt_create                      DateTime @default(now()) @db.DateTime(0)
  gmt_modified                    DateTime @default(now()) @db.DateTime(0)

  @@index([generation_job_id], map: "idx_slot_job")
  @@index([scene_card_generation_record_id], map: "idx_slot_record")
  @@index([project_id, initial_placement_status], map: "idx_slot_placement")
  @@unique([generation_job_id, slot_index], map: "uk_slot_job_index")
}

/// StoryboardPreview（IK67HF/T15，CONTEXT L43-47）：User 从 SceneCard 显式触发的分镜预览会话聚合根 +
/// SceneCard 绑定 + 幂等键。一次预览 = 一个 type=image 的 GenerationJob（first_generation_job_id），
/// 其 N 个 output_slot（按 slot_index 升序）即有序画格。可选旁路：不自动创建视频 job、不改 Preset、
/// 不切媒体类型（CONTEXT _Avoid_ L47）。画格本身复用 generation_output_slots + assets，本表只聚合会话。
/// command_id 兜底幂等（uk_storyboard_command，operation=scene_card.storyboard_preview）。
model storyboard_previews {
  id                          BigInt   @id @default(autoincrement())
  scene_card_id               BigInt
  project_id                  BigInt
  first_generation_job_id     BigInt
  command_id                  String   @db.VarChar(128)
  summary_status              String   @db.VarChar(16)
  capability_snapshot_version Json
  gmt_create                  DateTime @default(now()) @db.DateTime(0)
  gmt_modified                DateTime @default(now()) @db.DateTime(0)
  version                     Int      @default(1)
  is_delete                   Int      @default(0) @db.TinyInt

  @@unique([project_id, command_id], map: "uk_storyboard_command")
  @@index([scene_card_id], map: "idx_storyboard_scene")
  @@index([project_id], map: "idx_storyboard_project")
}

/// Immutable first-applied preview content, retained when its Canvas node is deleted.
model prompt_preview_snapshots {
  id          BigInt   @id @default(autoincrement())
  project_id  BigInt
  source_key  String   @db.VarChar(64)
  source_json Json
  title       String   @db.VarChar(200)
  text        String   @db.MediumText
  content_json Json?
  gmt_create  DateTime @default(now()) @db.DateTime(0)

  @@unique([project_id, source_key], map: "uk_prompt_preview_source")
}

/// Immutable conversation quote snapshot: node text captured when added to the conversation (IKDLQJ); retained after the source node is edited or deleted.
model conversation_quote_snapshots {
  id          BigInt   @id @default(autoincrement())
  project_id  BigInt
  quote_key   String   @db.VarChar(64)
  node_id     String   @db.VarChar(128)
  source_json Json?
  title       String   @db.VarChar(200)
  text        String   @db.MediumText
  gmt_create  DateTime @default(now()) @db.DateTime(0)

  @@unique([project_id, quote_key], map: "uk_conversation_quote")
}

/// Immutable legacy generation-card migration history (IKDLQK): card content captured before conversion to an ordinary text node; read-only, never rewritten by later edits.
model legacy_card_history {
  id          BigInt   @id @default(autoincrement())
  project_id  BigInt
  node_id     String   @db.VarChar(128)
  title       String   @db.VarChar(200)
  prompt_text String   @db.MediumText
  visual_text String?  @db.MediumText
  source_json Json?
  card_json   Json
  gmt_create  DateTime @default(now()) @db.DateTime(0)

  @@unique([project_id, node_id], map: "uk_legacy_card_history")
}
