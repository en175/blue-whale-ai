  /// 银行统一收银台链接（下单应答的 payData，内嵌银行令牌）。落库是为了**复用未支付订单**：
  /// 网关按 (mch_no, mch_order_no) 唯一，同一单号重下会被拒，链接事后要不回来。
  /// ⚠️ 判「有没有拿到过链接」看 pay_order_id（两者同一次更新写入，同真同假）
  cashier_url      String?   @db.VarChar(512)
  user_id          BigInt
  /// 档位 ID。**可空**：NULL = 这不是档位商品（自定义充值，`product_type = 'custom'`）。
  /// 自定义充值没有档位，编一个 0/1 出来会被后续按 tier_id 聚合的对账当成真档位。
  /// 判「是不是档位商品」一律看 product_type，不看这一列。
  tier_id          BigInt?
  amount_fen       BigInt
  credits          BigInt
  credits_per_yuan Int
  status           String    @default("pending") @db.VarChar(16)

  product_type            String    @default("tier") @db.VarChar(16)
  product_name            String    @default("") @db.VarChar(100)
  /// 本单应发的赠送积分（首购加赠），没有则 0。与 credits 分开记：退款只退本金，
  /// 且两者将来的有效期策略可能不同
  bonus_credits           BigInt    @default(0)
  /// 本单积分的到期时刻（**真实发给 billing 的那个时刻**），由发放那一步按
  /// `paid_pending_at + credits_valid_months` 算出并写上；下单时先写 NULL。
  /// NULL = 还没发放（或本列上线前的存量单，那种单按 billing 的来源策略发）
  credits_expire_at       DateTime? @db.DateTime(0)
  /// 到账积分有效期快照，单位**月**（来自档位 / 自定义充值配置）。
  /// ⚠️ 存月数不存时刻：起算点是**支付成功时刻**（PRD §9.5），下单那一刻还不知道它。
  /// NULL = 本列上线前的存量单（发放时由 billing 按来源策略决定有效期）
  credits_valid_months    Int?
  /// **发放时**服务端判定的首购状态：unknown 未判定（档位不参与，或拿不到归属）|
  /// first 本单是该档位首次、赠送已发 | repeat 该档位已用过赠送。
  /// ⚠️ 不在下单时定：两笔未支付单都会自认首单，真正的裁决在发放那一步（billing 唯一索引）
  first_purchase_state    String    @default("unknown") @db.VarChar(16)
  /// 该商品是否参与首购加赠（配置快照）。与 state 分开：一个说人，一个说商品
  first_purchase_eligible Int       @default(0) @db.TinyInt
  permission_result       String    @default("allowed") @db.VarChar(32)
  /// 档位配置版本快照（下单时刻 topup_tiers.version）。回答「这单是改价前还是改价后」
  config_version          Int       @default(0)

  paid_at          DateTime? @db.DateTime(0)
  /// **首次**进入 paid_pending（钱到了、积分还没发）的时刻；主动对账据此算持有分钟数。
  /// ⚠️ 不能用 gmt_modified 顶替（回调到达与查单名额都会改它）。
  /// NULL = 本列上线前进入该状态的存量单
  paid_pending_at  DateTime? @db.DateTime(0)
  last_query_at    DateTime? @db.DateTime(0)
  notify_count     Int       @default(0)
  gmt_create       DateTime  @default(now()) @db.DateTime(0)
  gmt_modified     DateTime  @default(now()) @db.DateTime(0)
  version          Int       @default(0)
  is_delete        Int       @default(0) @db.TinyInt

  /// 管理端「充值记录」全站列表：WHERE is_delete = 0 ORDER BY gmt_create DESC, id DESC。
  /// `is_delete` 做等值前缀、`gmt_create` 提供顺序；id 不必显式写进索引
  /// （InnoDB 二级索引自带主键，MySQL 8.0 判顺序时算上它，故无 filesort）。
  @@index([is_delete, gmt_create], map: "idx_recharge_orders__is_delete_gmt_create")
  /// 同一页「按用户筛选」：WHERE is_delete = 0 AND user_id = ? ORDER BY gmt_create DESC, id DESC。
  /// user_id 必须排在 gmt_create **之前**才收窄得到一个人；全站那条索引代替不了它。
  @@index([is_delete, user_id, gmt_create], map: "idx_recharge_orders__is_delete_user_gmt_create")
}

