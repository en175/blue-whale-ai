/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model generation_jobs {
  id                       BigInt    @id @default(autoincrement())
  project_id               BigInt?
  user_id                  BigInt
  retry_of_job_id          BigInt?
  type                     String    @db.VarChar(32)
  source                   String    @default("dock") @db.VarChar(32)
  status                   String    @default("queued") @db.VarChar(32)
  progress                 Int       @default(0)
  output_asset_ids         Json?
  provider                 String?   @db.VarChar(64)
  provider_task_id         String?   @db.VarChar(128)
  poll_count               Int       @default(0)
  retry_count              Int       @default(0)
  last_polled_at           DateTime? @db.DateTime(0)
  error                    Json?
  lease_owner              String?   @db.VarChar(128)
  lease_expires_at         DateTime? @db.DateTime(0)
  fencing_token            BigInt    @default(0)
  execution_deadline_at    DateTime? @db.DateTime(0)
  next_action_at           DateTime? @db.DateTime(0)
  cancel_requested_at      DateTime? @db.DateTime(0)
  gmt_create               DateTime  @default(now()) @db.DateTime(0)
  gmt_modified             DateTime  @default(now()) @db.DateTime(0)
  version                  Int       @default(0)
  is_delete                Boolean   @default(false)
  input                    Json?

  /// IKIZQC：成片来源唯一约束（契约 FINALIZE_SOURCE_UNIQUE_KEY）——同一来源样片
  /// 至多一条成片任务行；MySQL 唯一索引不去重 NULL，普通视频/样片行不受影响。
  /// 成片任务指向来源样片任务（仅 final 阶段非 null）。
  /// ⚠️ 本列**留在主表**：它扛着下面这条唯一索引，是并发裁决点。扩展表
  /// generation_job_extras 的唯一索引只能是 (generation_job_id, extra_key)，
  /// 改成按值唯一会让所有同 extra_key 的行互相撞（IKJCOE）。
  source_sample_job_id     BigInt?

  @@index([project_id], map: "idx_project_id")
  @@index([provider_task_id], map: "idx_provider_task_id")
  @@index([user_id], map: "idx_user_id")
  @@index([next_action_at], map: "idx_generation_next_action")
  @@unique([source_sample_job_id], map: "uk_generation_jobs__source_sample_job_id")
  /// 仪表盘区间统计：WHERE is_delete = 0 AND gmt_create ∈ [from, to)。
  /// `is_delete` 在前做等值前缀、`gmt_create` 走区间 —— 反过来放会让等值条件退化成过滤。
  @@index([is_delete, gmt_create], map: "idx_generation_jobs__is_delete_gmt_create")
}

/// IKJCOE：generation_jobs 的任务特有扩展位（键值形态）。
///
/// 为什么是键值而不是继续加列：任务类型各异（image/video/audio/抠图/混音/…），每种只用
/// 到少数几个扩展位。按列加会长成稀疏并集——每加一个类型的主表就多几列，而读路径
/// （job-repo.ts）是 findMany 无 select，列表页为此多传一次。按行存则「多一种类型」
/// 是加数据不是加列。
///
/// extra_key **沿用被迁移列的原字段名**（video_stage / charge_state / …），读方不用
/// 维护一层新旧名字映射。value_type ∈ string/number/boolean/json；number 用十进制
/// 字符串存 value_text（JS Number() / Java Long.parseLong 对称）。上限：超过 2^53 的
/// 数值必须用 string。
///
/// 刻意不建 generation_job_id 单列索引（唯一索引最左前缀已覆盖）；不建 is_delete /
/// version（追加型子表，跟随 generation_job_logs / generation_output_slots）；
/// 不建外键关系（全仓 0 个 @relation，子表一律父表先查 + 子表二次查询 + 内存聚合）。
model generation_job_extras {
  id                BigInt   @id @default(autoincrement())
  generation_job_id BigInt
  extra_key         String   @db.VarChar(64)
  value_type        String   @db.VarChar(16)
  value_text        String   @db.Text
  gmt_create        DateTime @default(now()) @db.DateTime(0)
  gmt_modified      DateTime @default(now()) @db.DateTime(0)

  /// 一个任务的一个扩展位只有一行；upsert 靠它判重，不靠应用层。
  @@unique([generation_job_id, extra_key], map: "uk_generation_job_extras__job_key")
}

model generation_outbox {
  id              BigInt    @id @default(autoincrement())
  job_id          BigInt
  user_id         BigInt
  terminal_status String    @db.VarChar(32)
  reason          String    @default("") @db.VarChar(512)
