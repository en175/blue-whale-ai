generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model assets {
  id                BigInt   @id @default(autoincrement())
  user_id           BigInt
  project_id        BigInt   @default(0)
  generation_job_id BigInt?
  type              String   @db.VarChar(16)
  name              String?  @db.VarChar(255)
  storage_key       String?  @db.VarChar(512)
  content_sha256    String?  @db.VarChar(64)
  md5               String?  @db.VarChar(32)
  url               String   @db.VarChar(512)
  mime              String?  @db.VarChar(64)
  size              BigInt?
  width             Int?
  height            Int?
  duration_ms       Int?
  source            String   @default("generated") @db.VarChar(32)
  status            String   @default("normal") @db.VarChar(32)
  // IKDJNZ：原始素材与素材库（真人/虚拟人像库）素材关联。素材库零本地表，
  // 仅存上游素材/组 ID 字符串；material_id 唯一索引兜底「一张素材只能关联一张」。
  material_id       String?  @db.VarChar(128)
  material_group_id String?  @db.VarChar(128)
  gmt_create        DateTime @default(now()) @db.DateTime(0)
  gmt_modified      DateTime @default(now()) @db.DateTime(0)
  version           Int      @default(0)
  is_delete         Boolean  @default(false)
  deleted_at        DateTime? @db.DateTime(0)

  @@index([project_id], map: "idx_asset_project")
  @@index([project_id, type], map: "idx_asset_project_type")
  @@index([generation_job_id], map: "idx_asset_generation_job")
  @@index([type], map: "idx_type")
  @@index([user_id], map: "idx_user_id")
  // IKBMDM：findLiveRefs 按 storage_key IN + is_delete=false 做引用核对，需要 storage_key 前缀索引。
  @@index([storage_key, is_delete], map: "idx_asset_storage_live")
  @@index([is_delete, deleted_at], map: "idx_asset_gc_candidates")
  // IKCNLS：上传 md5 去重按 (user_id, md5) 查未删资产，is_delete 条件支撑查询。
  @@index([user_id, md5, is_delete], map: "idx_asset_user_md5")
  // IKDJNZ：素材库素材/组删除旁路按 ID 清关联；material_id 唯一索引兜底一对一。
  @@unique([material_id], map: "uq_asset_material_id")
  @@index([material_group_id], map: "idx_asset_material_group")
}

/// IKDE6X：素材库组（虚拟人像库 + 真人像库）落地。本地为组主、上游备份、双向维护。
/// kind：virtual=虚拟人像库组（每用户至多 1 个默认组），real=真人像库组（每用户可多个）。
/// cover_url：封面图（真人组用，虚拟组可空）。material_group_id：上游组 id（group-...）。
/// is_default 每用户 virtual 至多 1 个用应用层保证（MySQL 唯一索引无法表达条件唯一，不设 DB 约束）。
model material_groups {
  id                BigInt    @id @default(autoincrement())
  user_id           BigInt
  material_group_id String    @db.VarChar(128) // 上游组 id（group-...）
  kind              String    @db.VarChar(16) // virtual | real
  name              String    @db.VarChar(128)
  cover_url         String?   @db.VarChar(512) // 封面图（真人组用，virtual 可空）
  is_default        Boolean   @default(false) // 每用户虚拟默认组标记
  status            String    @default("normal") @db.VarChar(32)
  gmt_create        DateTime  @default(now()) @db.DateTime(0)
  gmt_modified      DateTime  @default(now()) @db.DateTime(0)
  version           Int       @default(0)
  is_delete         Boolean   @default(false)
  deleted_at        DateTime? @db.DateTime(0)

  @@unique([user_id, material_group_id], map: "uk_material_group_user_upstream")
  @@index([user_id, kind], map: "idx_material_group_user_kind")
  @@index([user_id, is_delete], map: "idx_material_group_user_alive")
}

/// 素材校验状态（IKFYHJ）：镜像上游素材状态，作为生成任务「该素材能否用作视频生成参考」的判据。
/// status = Processing | Active | Failed；素材真身在上游，本表只存状态与失败原文（error_* 仅供内部归因，不展示）。
/// status_checked_at = 最后一次向上游确认状态的时间。
/// 无 is_delete/deleted_at：本表行是素材的附属状态，没有独立价值，删除时硬删（ADR-0087 决策 5）。
model material_assets {
  id                BigInt    @id @default(autoincrement())
  material_id       String    @unique(map: "uk_material_assets_material") @db.VarChar(128) // 上游素材 id（asset-...）
  user_id           BigInt // 归属用户（new-api 用户 id）
  material_group_id String    @db.VarChar(128) // 上游组 id（group-...）
  status            String    @db.VarChar(16) // Processing | Active | Failed
  error_code        String?   @db.VarChar(128) // 上游 Error.Code 原文
  error_message     String?   @db.VarChar(512) // 上游 Error.Message 原文
  status_checked_at DateTime? @db.DateTime(0)
  gmt_create        DateTime  @default(now()) @db.DateTime(0)
  gmt_modified      DateTime  @default(now()) @db.DateTime(0)
  version           Int       @default(0)

  @@index([status, gmt_create], map: "idx_material_assets_poll")
  @@index([material_group_id], map: "idx_material_assets_group")
}

/// 画布共享资产（IK9QKP）：用户主动保存、跨项目可复用的自包含快照库。
/// 两层类型对齐画布节点结构：asset_type = 节点大类（card/media/goods/scene/text），
/// kind = 节点判别字段（card 的 data.kind / media 的 data.mediaType；goods/scene/text 为 NULL）。
/// snapshot 统一存各类型全部数据（自包含，不依赖来源表）；name/thumbnail_url 为列表查询冗余列。
/// dedup_key 幂等去重：媒体 url sha256、卡片 类型+描述 sha256、商品 名称 sha256、场景 内容 sha256、文本 NULL。
model shared_assets {
  id            BigInt   @id @default(autoincrement())
  user_id       BigInt
  asset_type    String   @db.VarChar(16)
  kind          String?  @db.VarChar(16)
  name          String   @db.VarChar(255)
  thumbnail_url String?  @db.VarChar(512)
  snapshot      Json
  dedup_key     String?  @db.VarChar(128)
  status        String   @default("normal") @db.VarChar(16)
  gmt_create    DateTime @default(now()) @db.DateTime(0)
  gmt_modified  DateTime @default(now()) @db.DateTime(0)
  version       Int      @default(0)
  is_delete     Int      @default(0) @db.TinyInt

  @@unique([user_id, dedup_key], map: "uk_shared_user_dedup")
  @@index([user_id, asset_type, kind, is_delete], map: "idx_shared_user_type")
  @@index([user_id, gmt_create], map: "idx_shared_user_created")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model canvas {
