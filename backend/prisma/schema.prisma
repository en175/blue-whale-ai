/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model template_card_image {
  id           BigInt   @id @default(autoincrement())
  card_id      BigInt
  image_url    String   @db.VarChar(512)
  sort_order   Int      @default(0)
  is_delete    Int      @default(0) @db.TinyInt
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  version      Int      @default(0)

  @@index([card_id], map: "idx_card_id")
  @@index([card_id, sort_order], map: "idx_card_sort")
}

/// IK764F：首页模板标签（原硬编码枚举落库）。tag_code 与顺序固定，仅 label 可由管理后台改名。
model template_tag {
  id           BigInt   @id @default(autoincrement())
  tag_code     String   @db.VarChar(64)
  label        String   @db.VarChar(128)
  sort_order   Int      @default(0)
  visible      Int      @default(1) @db.TinyInt
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  is_delete    Int      @default(0) @db.TinyInt

  @@unique([tag_code], map: "uk_tag_code")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model user_skill {
  id           BigInt   @id @default(autoincrement())
  user_id      BigInt
  skill_id     BigInt
  auto         Int      @default(0) @db.TinyInt
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  version      Int      @default(0)
  is_delete    Int      @default(0) @db.TinyInt

  @@unique([user_id, skill_id], map: "uk_user_skill")
  @@index([skill_id], map: "idx_skill")
  @@index([user_id], map: "idx_user")
}

/// IKCH05：首页背景图/视频后台动态配置条目。media_type=video 时 poster_url 必填；
/// enabled=1 进首页轮播（按 sort_order 升序）；上限 8 条（应用层校验，不设 DB 唯一约束）。
model homepage_hero {
  id           BigInt   @id @default(autoincrement())
  media_type   String   @default("video") @db.VarChar(16) // image | video
  media_url    String   @db.VarChar(512) // 视频/图片 URL（TOS 迁移中可暂空）
  poster_url   String?  @db.VarChar(512) // 视频封面；media_type=video 必填
  sort_order   Int      @default(0)
  enabled      Int      @default(1) @db.TinyInt // 1 进轮播 / 0 停用
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  version      Int      @default(0)
  is_delete    Int      @default(0) @db.TinyInt

  @@index([enabled, is_delete, sort_order], map: "idx_hero_enabled_sort")
  @@index([sort_order, is_delete], map: "idx_hero_sort")
}

/// Creative Skill 稳定身份（IK60WS，资产契约 §1）：官方与个人共用一表；
/// owner_user_id=0 表示平台官方资产，asset_domain 区分 official/personal。
model creative_skill {
  id                BigInt   @id @default(autoincrement())
  creative_skill_id String   @unique(map: "uk_creative_skill_id") @db.VarChar(80)
  name              String   @db.VarChar(255)
  description       String?  @db.VarChar(1000)
  source_skill_id   BigInt?
  active_version_id String?  @db.VarChar(80)
  owner_user_id     BigInt   @default(0)
  asset_domain      String   @default("official") @db.VarChar(16)
  name_key          String?  @db.VarChar(255)
  auto_match        Int      @default(0)
  gmt_create        DateTime @default(now()) @db.DateTime(0)
  gmt_modified      DateTime @default(now()) @db.DateTime(0)

  @@index([owner_user_id, asset_domain], map: "idx_owner_domain")
  @@index([owner_user_id, name_key], map: "idx_owner_name_key")
}

/// Creative Skill 不可变版本快照（IK60WS，资产契约 §1）：
/// body 为剥掉 frontmatter 的纯正文，digest=sha256(body)，仅受信任运行时按 pin 读取。
model creative_skill_version {
  id                        BigInt   @id @default(autoincrement())
  creative_skill_version_id String   @unique(map: "uk_creative_skill_version_id") @db.VarChar(80)
  creative_skill_id         String   @db.VarChar(80)
  display_version           String   @db.VarChar(64)
  body                      String   @db.LongText
  content_digest            String   @db.VarChar(71)
  resource_digest           String   @db.VarChar(71)
  media_type                String   @default("text/markdown") @db.VarChar(128)
  gmt_create                DateTime @default(now()) @db.DateTime(0)
  gmt_modified              DateTime @default(now()) @db.DateTime(0)

  @@unique([creative_skill_id, display_version], map: "uk_creative_skill_version_semver")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// 账号主体（自建用户体系）。username 唯一、phone 可空，理由与 pre-flight 见
/// migration 20260924180000；表名与索引名的 `identity_` 前缀收敛到 `bw_` 见 migration 20260928100000。
/// ⚠️ `map:` 名必须与库内索引的实际名字**逐字一致**，否则 `prisma migrate` 会反复改 schema。
/// ⚠️ `username` 是**登录凭据**；`phone` 只是「多一种登录方式」，存量用户没有它。
model bw_users {
  id           BigInt   @id @default(autoincrement())
  phone        String?  @unique(map: "idx_phone") @db.VarChar(20)
  /// 邮箱。设计 §6.2 要求；与 username 一样是登录方式之一（email + password）。
  /// ⚠️ 唯一：登录按 `username = ? OR email = ?` 一次查出主体，邮箱不唯一时会命中
  /// **任意一行**——等于能用别人的邮箱登进来。NULL 可多行，空串不可
  /// （MySQL 唯一索引对 NULL 互不相等，对空串不是）。见 migration 20260925120000。
  email        String?  @unique(map: "uk_bw_users__email") @db.VarChar(50)
  username     String   @db.VarChar(50)
  status       String   @default("NORMAL") @db.VarChar(30)
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  version      Int      @default(1)
  is_delete    Boolean  @default(false)
  avatar       String?  @default("0") @db.VarChar(255)
  /// bcrypt 哈希（cost 10，与 new-api 一致）。**可空**：手机号注册、以及刚从
  /// new-api 迁来还没设过我们侧口令的行没有它。校验路径必须把 NULL 当作
  /// 「不能用口令登录」，而不是「任意口令都能登」——见 `libs/shared/identity/password.ts`。
  password     String?  @db.VarChar(63)

  @@unique([username], map: "uk_bw_users__username")
}

/// 短信验证码。手机号登录是**后续**能力（发码已通、登录未接，`loginWithCode` 零调用者）。
model bw_verification_codes {
  id         BigInt   @id @default(autoincrement())
  phone      String   @db.VarChar(20)
  code       String   @db.VarChar(6)
  ip         String   @db.VarChar(50)
  gmt_expire DateTime @db.DateTime(0)
  is_used    Boolean  @default(false)
  gmt_create DateTime @default(now()) @db.DateTime(0)

  @@index([ip, gmt_create], map: "idx_ip_created")
  @@index([phone, gmt_create], map: "idx_phone_created")
  @@index([phone, is_used, gmt_expire], map: "idx_phone_unused")
}

// ===== 充值档位（blue_whale 侧 CRUD，支付执行走 Go new-api） =====
//
// ⚠️ 列序 = 迁移里的物理列序（新列一律 `ALTER TABLE … ADD COLUMN` 追加在末尾，
// 所以模型里也写在末尾）。**重排这里的顺序不是无害的排版**：下一次
// `prisma migrate` 会把它识别成一次列重排，生成一串没人读得懂的 MODIFY。

model topup_tiers {
  id             BigInt    @id @default(autoincrement())
  name           String    @default("") @db.VarChar(100)
  amount         BigInt
  original_price Decimal   @db.Decimal(10, 2)
  discount       Decimal   @default(1) @db.Decimal(5, 4)
  price          Decimal   @db.Decimal(10, 2)
  is_recommended Boolean   @default(false)
  /// 三态（PRD §10.5）：draft 草稿 | active 上架 | inactive 下架。
  /// ⚠️ **默认 draft** —— 新建卡片默认草稿，不展示给用户，运营配齐再上架。
  /// 存量行不动（它们已经是上架/下架，没有理由回退成草稿）。
  status         String    @default("draft") @db.VarChar(16)
  start_time     DateTime? @db.DateTime(0)
  end_time       DateTime? @db.DateTime(0)
  sort_order     Int       @default(0)
  gmt_create     DateTime  @default(now()) @db.DateTime(0)
  gmt_modified   DateTime  @default(now()) @db.DateTime(0)
  version        Int       @default(0)
  is_delete      Int       @default(0) @db.TinyInt

  // ── 卡片展示与首购活动（PRD §10.2；2026-09-26 由迁移 047 追加，故排在末尾）──
  description              String  @default("") @db.VarChar(255)
  bonus_credits            BigInt  @default(0)
  activity_tag             String  @default("") @db.VarChar(64)
  button_text              String  @default("立享加赠") @db.VarChar(32)
  first_purchase_eligible  Int     @default(0) @db.TinyInt
  /// 到账积分有效期，单位**月**（默认 2 年 = 24 个月）。口径钉死为月，年表达不了 6/18 个月
  credits_valid_months     Int     @default(24)
  /// all 全部登录用户 | user_group 指定用户群 | member_tier 指定会员等级（阶段 2 生效，先占位）
  permission               String  @default("all") @db.VarChar(16)
  /// JSON 数组，元素是 userId 的十进制字符串（BigInt 超 JS 安全整数，存串不丢精度）
  permission_allowlist     Json?
  permission_denied_hint   String  @default("") @db.VarChar(255)

  // ── 基础积分：**配置值**（2026-09-27 由迁移 048 追加，故排在末尾）──
  /// 用户下单到账的基础积分（整数积分）。**配置值，不是派生值**（推翻迁移 047 的派生决定）：
  /// 充值的「元 → 积分」与消费锚点「1 元 = 15 积分」不是一回事 —— 充值常有折扣。
  /// `original_price`/`discount` 只为展示划线价，与积分**再无数学关系**：
  /// ¥499 给 7,500 积分（499×15=7,485 只是巧合），看到「不是原价的整数倍」不要去修。
  /// 0 = 还没配过基础积分，下单会被拒（宁可下不了单，也不发 0 积分）。
  base_credits             BigInt  @default(0)

  @@index([status, sort_order], map: "idx_tier_status_sort")
}

// ===== 充值订单（blue_whale 侧；支付执行在 blue-whale-pay 的杭州银行聚合主扫渠道） =====
//
// 到账积分在下单时刻冻结（credits/credits_per_yuan）：换算率是定价目录的配置项、可改，
// 用户按「N 积分」付了钱之后改口径不能反悔。
//
// ⚠️ **`status=paid` 不再是「积分已发放」的唯一判据**（2026-09-26 起）。状态机从 4 态扩到 6 态：
//   pending 待支付 | paid_pending 支付成功待到账 | paid 已到账 | failed 支付失败
//   | expired 已取消（用户取消或超时；沿用旧值不改名）| grant_failed 到账异常
// 拆出 `paid_pending` 是为了让「**钱到了但积分没发成功**」第一次可表达 ——
// 在此之前那种单停在 `pending`，与「用户还没付钱」长得一模一样，客服分不出来。
// 判据要写「>= 待到账」，不要写 `= paid`。
//
// ⚠️ 刻意**没有**「已退款」状态：退款功能先不做。一个没有出口的状态就是死状态。
model recharge_orders {
  id               BigInt    @id @default(autoincrement())
  trade_no         String    @unique(map: "uk_recharge_orders__trade_no") @db.VarChar(64)
  pay_order_id     String?   @unique(map: "uk_recharge_orders__pay_order_id") @db.VarChar(64)
  /// 银行统一收银台链接（下单应答的 payData，内嵌银行令牌）。落库是为了**复用未支付订单**：
  /// 网关按 (mch_no, mch_order_no) 唯一，同一单号重下会被拒，链接事后要不回来。
  /// ⚠️ 判「有没有拿到过链接」看 pay_order_id（两者同一次更新写入，同真同假）
  cashier_url      String?   @db.VarChar(512)
  user_id          BigInt
  /// 档位 ID。**可空**：NULL = 这不是档位商品（自定义充值，`product_type = 'custom'`）。
  /// 自定义充值没有档位，编一个 0/1 出来会被后续按 tier_id 聚合的对账当成真档位。
  /// 判「是不是档位商品」一律看 product_type，不看这一列。
  tier_id          BigInt?
  amount_fen       BigInt
  credits          BigInt
  credits_per_yuan Int
  status           String    @default("pending") @db.VarChar(16)

  // ── 快照（PRD §9.3）：下单时刻的商品与活动，后台之后改配置不影响已创建订单 ──
  product_type            String    @default("tier") @db.VarChar(16)
  product_name            String    @default("") @db.VarChar(100)
  /// 本单应发的赠送积分（首购加赠），没有则 0。与 credits 分开记：退款只退本金，
  /// 且两者将来的有效期策略可能不同
  bonus_credits           BigInt    @default(0)
  /// 本单积分的到期时刻（**真实发给 billing 的那个时刻**），由发放那一步按
  /// `paid_pending_at + credits_valid_months` 算出并写上；下单时先写 NULL。
  /// NULL = 还没发放（或本列上线前的存量单，那种单按 billing 的来源策略发）
  credits_expire_at       DateTime? @db.DateTime(0)
  /// 到账积分有效期快照，单位**月**（来自档位 / 自定义充值配置）。
  /// ⚠️ 存月数不存时刻：起算点是**支付成功时刻**（PRD §9.5），下单那一刻还不知道它。
  /// NULL = 本列上线前的存量单（发放时由 billing 按来源策略决定有效期）
  credits_valid_months    Int?
  /// **发放时**服务端判定的首购状态：unknown 未判定（档位不参与，或拿不到归属）|
  /// first 本单是该档位首次、赠送已发 | repeat 该档位已用过赠送。
  /// ⚠️ 不在下单时定：两笔未支付单都会自认首单，真正的裁决在发放那一步（billing 唯一索引）
  first_purchase_state    String    @default("unknown") @db.VarChar(16)
  /// 该商品是否参与首购加赠（配置快照）。与 state 分开：一个说人，一个说商品
  first_purchase_eligible Int       @default(0) @db.TinyInt
  permission_result       String    @default("allowed") @db.VarChar(32)
  /// 档位配置版本快照（下单时刻 topup_tiers.version）。回答「这单是改价前还是改价后」
  config_version          Int       @default(0)

  paid_at          DateTime? @db.DateTime(0)
  /// **首次**进入 paid_pending（钱到了、积分还没发）的时刻；主动对账据此算持有分钟数。
  /// ⚠️ 不能用 gmt_modified 顶替（回调到达与查单名额都会改它）。
  /// NULL = 本列上线前进入该状态的存量单
  paid_pending_at  DateTime? @db.DateTime(0)
  last_query_at    DateTime? @db.DateTime(0)
  notify_count     Int       @default(0)
  gmt_create       DateTime  @default(now()) @db.DateTime(0)
  gmt_modified     DateTime  @default(now()) @db.DateTime(0)
  version          Int       @default(0)
  is_delete        Int       @default(0) @db.TinyInt

  /// 管理端「充值记录」全站列表：WHERE is_delete = 0 ORDER BY gmt_create DESC, id DESC。
  /// `is_delete` 做等值前缀、`gmt_create` 提供顺序；id 不必显式写进索引
  /// （InnoDB 二级索引自带主键，MySQL 8.0 判顺序时算上它，故无 filesort）。
  @@index([is_delete, gmt_create], map: "idx_recharge_orders__is_delete_gmt_create")
  /// 同一页「按用户筛选」：WHERE is_delete = 0 AND user_id = ? ORDER BY gmt_create DESC, id DESC。
  /// user_id 必须排在 gmt_create **之前**才收窄得到一个人；全站那条索引代替不了它。
  @@index([is_delete, user_id, gmt_create], map: "idx_recharge_orders__is_delete_user_gmt_create")
}

// ===== 自定义充值配置（模块 B，PRD §7 / §10.3）。**单行表**，id 恒为 1 =====
//
// ⚠️ 刻意**不塞进 `system_settings`**：那张表存凭证（AES 密文、is_secret 标记、换密钥要
// 重写全部密文行的轮换语义），而这里存的是商品配置（明文、要按字段查询与校验、
// 随运营调价高频变更）。混在一张表里，迟早有人给商品配置也套上加密，
// 或者把凭证当成一份普通 JSON 去解析。
//
// 单行（主键钉住）而不是「一个字段一行」：PRD §10.3 的九个字段是一份**完整口径**，
// 分开存会出现「下限改了、上限还是旧的」那种中间态被读到。
//
// ⚠️ `credits_per_yuan` 是**本表自己的**换算率（PRD §7.1 默认 1 元 = 15 积分），
// 与定价目录里那条**消费锚点**（生成任务扣分用）不是一回事。自定义充值是**唯一**
// 真的拿这条比例算价格的地方：`价格(分) = round(积分数 × 100 ÷ 每元积分数)`。
// 档位的到账积分与此无关（读 `topup_tiers.base_credits`，配置值）。
model recharge_custom_config {
  /// 恒为 1：单行表，主键把「只有一份配置」钉在 schema 上
  id                     Int      @id
  /// 最低充值积分（PRD §7.1 默认 600 = ¥40）
  min_credits            BigInt   @default(600)
  /// 最高充值积分（PRD §7.1 默认 499,995）。保存时校验能被 credits_per_yuan 整除
  max_credits            BigInt   @default(499995)
  /// 默认选中积分（PRD §7.1 默认 600）
  default_credits        BigInt   @default(600)
  /// 每元积分数（PRD §7.1 默认 15）。**价格算法的输入**，不是消费锚点，见上方说明
  credits_per_yuan       Int      @default(15)
  /// 积分步长（PRD §10.3）。滑杆步进与手输修正用。
  /// 约束（服务端校验）：max-min 与 default-min 都必须是它的整数倍，否则滑杆推不到两端
  step_credits           BigInt   @default(15)
  /// 是否启用（PRD §10.3）。0 = 用户侧不展示自定义充值，下单被拒
  enabled                Int      @default(1) @db.TinyInt
  /// 购买权限（PRD §10.3「与固定积分卡一致」，枚举与 topup_tiers.permission 同一套）：
  /// all 全部登录用户 | user_group 指定用户群 | member_tier 指定会员等级（阶段 2 生效）
  permission             String   @default("all") @db.VarChar(16)
  /// JSON 数组，元素是 userId 的十进制字符串（BigInt 超 JS 安全整数，存串不丢精度）
  permission_allowlist   Json?
  /// 无权限提示（PRD §10.3 选填）。空串 = 用前端默认文案
  permission_denied_hint String   @default("") @db.VarChar(255)
  /// 到账积分有效期，单位**月**（PRD §10.3 默认 2 年 = 24 个月），与档位同口径
  credits_valid_months   Int      @default(24)
  /// 配置版本：**每保存一次 +1**。下单时快照进 recharge_orders.config_version
  version                Int      @default(0)
  gmt_create             DateTime @default(now()) @db.DateTime(0)
  gmt_modified           DateTime @default(now()) @db.DateTime(0)
}

// ===== 系统设置（管理端可配；按模块整行存一份快照） =====
//
// is_secret=1 的行必须是密文（AES-256-GCM），密钥只在进程环境变量里——
// 库与密钥分开存放，只拿到库也读不出凭证。
model system_settings {
  setting_key   String   @id @db.VarChar(64)
  setting_value String   @db.Text
  is_secret     Boolean  @default(false)
  gmt_create    DateTime @default(now()) @db.DateTime(0)
  gmt_modified  DateTime @default(now()) @db.DateTime(0)
  version       Int      @default(0)
}

// ===== 管理后台操作审计（blue_whale 侧，记录管理变更操作；只记写操作，查询不记） =====

model admin_operation_logs {
  id             BigInt   @id @default(autoincrement())
  category       String   @default("") @db.VarChar(32)
  action         String   @db.VarChar(64)
  target         String   @default("") @db.VarChar(255)
  target_user_id BigInt?
  detail         String   @db.Text
  operator       String   @default("") @db.VarChar(64)
  operator_id    BigInt?
  ip_address     String?  @db.VarChar(64)
  gmt_create     DateTime @default(now()) @db.DateTime(0)
  gmt_modified   DateTime @default(now()) @db.DateTime(0)
  version        Int      @default(0)
  is_delete      Int      @default(0) @db.TinyInt

  @@index([category, gmt_create], map: "idx_oplog_category_created")
}

// ===== 生成子系统（简化版，Node 自有 worker）：流水 + 日志 + 素材关联 + 点数 =====

model cost_reservations {
  id                    BigInt   @id @default(autoincrement())
  generation_job_id     BigInt
  user_id               BigInt
  project_id            BigInt
  action_identity       String   @db.VarChar(128)
  action_type           String   @db.VarChar(64)
  provider              String   @db.VarChar(64)
  reserved_amount_fen   BigInt
  actual_amount_fen     BigInt?
  status                String   @db.VarChar(32)
  /** IK9VZ0：释放原因/退款校验结果（如 "refund_confirmed" 已确认无扣费 / "refund_unverified" 未校验或可能已扣）。 */
  release_note          String?  @db.VarChar(255)
  price_catalog_version String   @db.VarChar(64)
  exchange_rate_version String   @db.VarChar(64)
  model_policy_version  String   @db.VarChar(64)
  cost_rule_version     String   @db.VarChar(64)
  gmt_create            DateTime @default(now()) @db.DateTime(0)
  gmt_modified          DateTime @default(now()) @db.DateTime(0)
  version               Int      @default(0)
  is_delete             Int      @default(0) @db.TinyInt

  @@unique([generation_job_id], map: "uk_cost_reservation_job")
}

/// IK9VZ0：多退少补结算审计（蓝鲸端只记账，执行在 new-api）：new-api 结算结果的接收记录。
/// 幂等：batch_no 整批唯一（uk_adj_batch）；(generation_job_id, action_type) 单项唯一（uk_adj_job_action，
/// 仅对有 job 归属的调整生效；MySQL 唯一索引对 NULL 不生效，无 job 的调整靠整批幂等兜底）。
model cost_adjustments {
  id                BigInt   @id @default(autoincrement())
  batch_no          String   @db.VarChar(64)
  generation_job_id BigInt?
  user_id           BigInt
  project_id        BigInt?
  action_type       String   @db.VarChar(32) // "refund" | "supplement"（退/补）
  amount_fen        BigInt
  reason            String   @db.VarChar(255)
  status            String   @db.VarChar(32) // "applied" | "duplicate"
  new_api_snapshot  String?  @db.Text
  gmt_create        DateTime @default(now()) @db.DateTime(0)
  gmt_modified      DateTime @default(now()) @db.DateTime(0)
  version           Int      @default(0)
  is_delete         Int      @default(0) @db.TinyInt

  @@unique([batch_no], map: "uk_adj_batch")
  @@unique([generation_job_id, action_type], map: "uk_adj_job_action")
}

/// 生成任务操作日志（append-only，追溯还原）：每次状态变更 / provider 调用记一行。
model generation_job_logs {
  id                BigInt   @id @default(autoincrement())
  generation_job_id BigInt
  event             String   @db.VarChar(64)
  status            String?  @db.VarChar(32)
  payload           Json?
  message           String?  @db.Text
  occurred_at       DateTime @default(now()) @db.DateTime(0)

  @@index([generation_job_id, occurred_at], map: "idx_gen_job_log_job_time")
}

/// 计划应用回执（IK67H9/IK67H8，契约 §9 / CONTEXT L217-221）：一次成功应用 PlanMessage 的不可变事实。
/// 视频路径记 scene_card_id/结果版本/预设摘要；图片路径 scene_card_id 为 NULL 并记会话/运行归属。
/// uk_plan_application_receipt_message 兜底「每条 PlanMessage 最多一次成功应用」（CONTEXT L227）。
model plan_application_receipts {
  id                         BigInt   @id @default(autoincrement())
  message_id                 BigInt   @unique(map: "uk_plan_application_receipt_message")
  project_id                 BigInt
  conversation_id            BigInt?
  agent_run_id               BigInt?
  application_kind           String   @db.VarChar(32)
  scene_card_id              BigInt?
  first_generation_job_id    BigInt
  command_id                 String   @db.VarChar(128)
  content_digest             String   @db.VarChar(80)
  result_version             Int?
  preset_digest              String?  @db.VarChar(80)
  target_scene_card_mention_id BigInt?
  applied_at                 DateTime @db.DateTime(0)
  gmt_create                 DateTime @default(now()) @db.DateTime(0)

  @@unique([project_id, command_id], map: "uk_plan_application_command")
  @@index([first_generation_job_id], map: "idx_plan_application_job")
}

/// 场景卡生成预设（IK67H9，CONTEXT L49-58）：SceneCard 1:1 持久拥有的视频生成参数，
/// 首次应用从 PlanMessage 冻结参数创建。必有时长与视频参考模式；首/尾帧角色存 reference_assets。
model scene_card_generation_presets {
  id                          BigInt   @id @default(autoincrement())
  scene_card_id               BigInt   @unique(map: "uk_preset_scene")
  project_id                  BigInt
  parameters                  Json
  reference_mode              String   @db.VarChar(32)
  reference_assets            Json
  capability_snapshot_version Json
  gmt_create                  DateTime @default(now()) @db.DateTime(0)
  gmt_modified                DateTime @default(now()) @db.DateTime(0)
  version                     Int      @default(1)
  is_delete                   Int      @default(0) @db.TinyInt

  @@index([project_id], map: "idx_preset_project")
}

/// 场景卡生成记录（IK67H9，CONTEXT L82-86）：User 从 SceneCard 发起的一次新生成及重试的聚合。
/// summary_status 四态：generating/partial/success/failed。来源指向 plan_message 与应用回执。
model scene_card_generation_records {
  id                      BigInt   @id @default(autoincrement())
  scene_card_id           BigInt
  project_id              BigInt
  summary_status          String   @db.VarChar(16)
  plan_message_id         BigInt
  application_receipt_id  BigInt
  first_generation_job_id BigInt
  gmt_create              DateTime @default(now()) @db.DateTime(0)
  gmt_modified            DateTime @default(now()) @db.DateTime(0)
  version                 Int      @default(1)
  is_delete               Int      @default(0) @db.TinyInt

  @@index([scene_card_id], map: "idx_record_scene")
  @@index([project_id], map: "idx_record_project")
  @@index([summary_status], map: "idx_record_status")
}

/// 生成输出槽位（IK67HE/T14，spec §4.4 / ADR-0026）：每次生成在提交时固定数量的槽，
/// 身份与顺序稳定（slot_index）。成功 Asset 永久占据原槽；重试只补 failed/missing 槽，
/// 不覆盖成功输出。scene_card_generation_record_id 关联 SceneCard 视频聚合（视频路径）；
/// 图片路径留空。retry_of_slot_id 指向被重试的原始槽，形成同槽位重试链。
model generation_output_slots {
  id                              BigInt   @id @default(autoincrement())
  project_id                      BigInt
  generation_job_id               BigInt
  scene_card_generation_record_id BigInt?
  slot_index                      Int
  status                          String   @db.VarChar(24) // pending/succeeded/failed/missing
  asset_id                        BigInt?
  retry_of_slot_id                BigInt?
  initial_placement_status        String   @default("pending") @db.VarChar(16) // pending/placed
  gmt_create                      DateTime @default(now()) @db.DateTime(0)
  gmt_modified                    DateTime @default(now()) @db.DateTime(0)

  @@index([generation_job_id], map: "idx_slot_job")
  @@index([scene_card_generation_record_id], map: "idx_slot_record")
  @@index([project_id, initial_placement_status], map: "idx_slot_placement")
  @@unique([generation_job_id, slot_index], map: "uk_slot_job_index")
}

/// StoryboardPreview（IK67HF/T15，CONTEXT L43-47）：User 从 SceneCard 显式触发的分镜预览会话聚合根 +
/// SceneCard 绑定 + 幂等键。一次预览 = 一个 type=image 的 GenerationJob（first_generation_job_id），
/// 其 N 个 output_slot（按 slot_index 升序）即有序画格。可选旁路：不自动创建视频 job、不改 Preset、
/// 不切媒体类型（CONTEXT _Avoid_ L47）。画格本身复用 generation_output_slots + assets，本表只聚合会话。
/// command_id 兜底幂等（uk_storyboard_command，operation=scene_card.storyboard_preview）。
model storyboard_previews {
  id                          BigInt   @id @default(autoincrement())
  scene_card_id               BigInt
  project_id                  BigInt
  first_generation_job_id     BigInt
  command_id                  String   @db.VarChar(128)
  summary_status              String   @db.VarChar(16)
  capability_snapshot_version Json
  gmt_create                  DateTime @default(now()) @db.DateTime(0)
  gmt_modified                DateTime @default(now()) @db.DateTime(0)
  version                     Int      @default(1)
  is_delete                   Int      @default(0) @db.TinyInt

  @@unique([project_id, command_id], map: "uk_storyboard_command")
  @@index([scene_card_id], map: "idx_storyboard_scene")
  @@index([project_id], map: "idx_storyboard_project")
}

/// Immutable first-applied preview content, retained when its Canvas node is deleted.
model prompt_preview_snapshots {
  id          BigInt   @id @default(autoincrement())
  project_id  BigInt
  source_key  String   @db.VarChar(64)
  source_json Json
  title       String   @db.VarChar(200)
  text        String   @db.MediumText
  content_json Json?
  gmt_create  DateTime @default(now()) @db.DateTime(0)

  @@unique([project_id, source_key], map: "uk_prompt_preview_source")
}

/// Immutable conversation quote snapshot: node text captured when added to the conversation (IKDLQJ); retained after the source node is edited or deleted.
model conversation_quote_snapshots {
  id          BigInt   @id @default(autoincrement())
  project_id  BigInt
  quote_key   String   @db.VarChar(64)
  node_id     String   @db.VarChar(128)
  source_json Json?
  title       String   @db.VarChar(200)
  text        String   @db.MediumText
  gmt_create  DateTime @default(now()) @db.DateTime(0)

  @@unique([project_id, quote_key], map: "uk_conversation_quote")
}

/// Immutable legacy generation-card migration history (IKDLQK): card content captured before conversion to an ordinary text node; read-only, never rewritten by later edits.
model legacy_card_history {
  id          BigInt   @id @default(autoincrement())
  project_id  BigInt
  node_id     String   @db.VarChar(128)
  title       String   @db.VarChar(200)
  prompt_text String   @db.MediumText
  visual_text String?  @db.MediumText
  source_json Json?
  card_json   Json
  gmt_create  DateTime @default(now()) @db.DateTime(0)

  @@unique([project_id, node_id], map: "uk_legacy_card_history")
}

/// 会员周期（bw_memberships）。自建用户体系第一刀，建表理由见 migration 20260924120000。
/// 一行 = 一个会员周期，**不是**「用户当前等级」——当前等级是这些周期的一个推导。
/// tier 是 billing 侧会员折扣的输入，也是这张表存在的理由。
model bw_memberships {
  id           BigInt    @id @default(autoincrement())
  user_id      BigInt
  tier         String    @db.VarChar(16)
  status       String    @default("active") @db.VarChar(16)
  started_at   DateTime  @db.DateTime(0)
  expires_at   DateTime? @db.DateTime(0)
  source       String    @db.VarChar(24)
  biz_id       String    @db.VarChar(128)
  grant_key    String    @db.VarChar(190)
  gmt_create   DateTime  @default(now()) @db.DateTime(0)
  gmt_modified DateTime  @default(now()) @db.DateTime(0)
  version      Int       @default(0)
  is_delete    Boolean   @default(false)

  @@unique([grant_key], map: "uk_bw_memberships__grant_key")
  @@index([user_id, status, expires_at], map: "idx_bw_memberships__user_status_expiry")
}

/// 角色（bw_roles）。替代 `auth.guard.ts` 里 `role >= 10` 的魔数——
/// 判断管理员是「持不持有 admin 类角色」的**集合成员**问题，不是数值比较问题。
/// 内置三行由 migration 20260924200000 播种。
model bw_roles {
  id           BigInt   @id @default(autoincrement())
  code         String   @db.VarChar(32)
  name         String   @db.VarChar(64)
  description  String   @default("") @db.VarChar(255)
  is_builtin   Boolean  @default(false)
  sort_order   Int      @default(0)
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  version      Int      @default(0)
  is_delete    Boolean  @default(false)

  @@unique([code], map: "uk_bw_roles__code")
}

/// 用户 ↔ 角色（bw_user_roles）。存 role_id 而非 code：角色改名只改一行，
/// 不散落成几十条待更新的关联行。
model bw_user_roles {
  id           BigInt   @id @default(autoincrement())
  user_id      BigInt
  role_id      BigInt
  granted_by   String   @default("system") @db.VarChar(64)
  grant_key    String   @db.VarChar(190)
  gmt_create   DateTime @default(now()) @db.DateTime(0)
  gmt_modified DateTime @default(now()) @db.DateTime(0)
  version      Int      @default(0)
  is_delete    Boolean  @default(false)

  @@unique([grant_key], map: "uk_bw_user_roles__grant_key")
  @@index([user_id, is_delete], map: "idx_bw_user_roles__user")
}

/// 登录日志（bw_login_logs）。`user_id` 可空——登录失败时用户可能压根不存在，
/// 而这些恰恰是最需要留痕的尝试。
model bw_login_logs {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt?
  username   String   @db.VarChar(50)
  ip         String   @db.VarChar(50)
  user_agent String   @default("") @db.VarChar(255)
  success    Boolean
  reason     String   @default("") @db.VarChar(64)
  gmt_create DateTime @default(now()) @db.DateTime(0)

  @@index([user_id, gmt_create], map: "idx_bw_login_logs__user_time")
  @@index([ip, gmt_create], map: "idx_bw_login_logs__ip_time")
}
