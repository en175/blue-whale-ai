generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model user_assets {
  id                BigInt   @id @default(autoincrement())
  user_id           BigInt
  project_id        BigInt   @default(0)
  generation_job_id BigInt?
  type              String   @db.VarChar(16)
  name              String?  @db.VarChar(255)
  storage_key       String?  @db.VarChar(512)
  content_sha256    String?  @db.VarChar(64)
  md5               String?  @db.VarChar(32)
  url               String   @db.VarChar(512)
  mime              String?  @db.VarChar(64)
  size              BigInt?
  width             Int?
  height            Int?
  duration_ms       Int?
  source            String   @default("generated") @db.VarChar(32)
  status            String   @default("normal") @db.VarChar(32)
  material_id       String?  @db.VarChar(128)
  gmt_create        DateTime @default(now()) @db.DateTime(0)
  gmt_modified      DateTime @default(now()) @db.DateTime(0)
  version           Int      @default(0)
  is_delete         Boolean  @default(false)
  deleted_at        DateTime? @db.DateTime(0)

  @@index([project_id], map: "idx_asset_project")
  @@index([project_id, type], map: "idx_asset_project_type")
  @@index([generation_job_id], map: "idx_asset_generation_job")
  @@index([type], map: "idx_type")
  @@index([user_id], map: "idx_user_id")
  @@index([storage_key, is_delete], map: "idx_asset_storage_live")
  @@index([is_delete, deleted_at], map: "idx_asset_gc_candidates")
  @@index([user_id, md5, is_delete], map: "idx_asset_user_md5")
  @@unique([material_id], map: "uq_asset_material_id")
}

/// IKDE6X：素材库组（虚拟人像库 + 真人像库）落地。本地为组主、上游备份、双向维护。
/// kind：virtual=虚拟人像库组（每用户至多 1 个默认组），real=真人像库组（每用户可多个）。
/// cover_url：封面图（真人组用，虚拟组可空）。material_group_id：上游组 id（group-...）。
/// is_default 每用户 virtual 至多 1 个用应用层保证（MySQL 唯一索引无法表达条件唯一，不设 DB 约束）。
model user_material_groups {
  id                BigInt    @id @default(autoincrement())
  user_id           BigInt
  material_group_id String    @db.VarChar(128)
  kind              String    @db.VarChar(16)
  name              String    @db.VarChar(128)
  cover_url         String?   @db.VarChar(512)
  is_default        Boolean   @default(false)
  status            String    @default("normal") @db.VarChar(32)
  gmt_create        DateTime  @default(now()) @db.DateTime(0)
  gmt_modified      DateTime  @default(now()) @db.DateTime(0)
  version           Int       @default(0)
  is_delete         Boolean   @default(false)
  deleted_at        DateTime? @db.DateTime(0)

  @@unique([user_id, material_group_id], map: "uk_material_group_user_upstream")
  @@index([user_id, kind], map: "idx_material_group_user_kind")
  @@index([user_id, is_delete], map: "idx_material_group_user_alive")
}

/// 素材校验状态（IKFYHJ）：镜像上游素材状态，作为生成任务「该素材能否用作视频生成参考」的判据。
/// status = Processing | Active | Failed；素材真身在上游，本表只存状态与失败原文（error_* 仅供内部归因，不展示）。
/// status_checked_at = 最后一次向上游确认状态的时间。
/// 无 is_delete/deleted_at：本表行是素材的附属状态，没有独立价值，删除时硬删（ADR-0087 决策 5）。
model user_material_info {
  id                BigInt    @id @default(autoincrement())
  material_id       String    @unique(map: "uk_user_material_info__material") @db.VarChar(128)
  user_id           BigInt
  material_group_id String    @db.VarChar(128)
  status            String    @db.VarChar(16)
  error_code        String?   @db.VarChar(128)
  error_message     String?   @db.VarChar(512)
  status_checked_at DateTime? @db.DateTime(0)
  gmt_create        DateTime  @default(now()) @db.DateTime(0)
  gmt_modified      DateTime  @default(now()) @db.DateTime(0)
  version           Int       @default(0)

  @@index([status, gmt_create], map: "idx_user_material_info__poll")
  @@index([material_group_id], map: "idx_user_material_info__group")
}

