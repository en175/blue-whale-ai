{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": false,
    "composite": true,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@lib/*": [
        "libs/*"
      ],
      "@lib/contracts": [
        "libs/contracts/index.ts"
      ],
      "@lib/core": [
        "libs/core/index.ts"
      ],
      "@lib/core/logging": [
        "libs/core/logging.ts"
      ],
      "@lib/core/readiness": [
        "libs/core/readiness.ts"
      ]
    }
  },
  "include": [
    "apps/**/*.ts",
    "libs/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.testlib.ts"
  ],
  "references": []
}