# generation-worker 镜像（prod 视频生成消费者，NestJS app）。
#
# 消费 BullMQ generation-video 队列：调 new-api 出片、写 DB/TOS。
# 与主 API（apps/blue-whale）同构构建：tsc -b + tsc-alias → node dist。
#
# 构建（context = 仓库根）：
#   docker build -f backend/Dockerfile.worker -t blue-whale-worker:latest .

FROM node:24-alpine
RUN corepack enable
WORKDIR /app

# ffmpeg-static 二进制走 npmmirror 镜像（避免 postinstall 从 GitHub 下载，国内构建超时）
ENV FFMPEG_BINARIES_URL=https://registry.npmmirror.com/-/binary/ffmpeg-static

# workspace 根 + 各 package.json（pnpm install 解析 workspace:*）
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/core/package.json packages/core/
COPY packages/persistence/package.json packages/persistence/
COPY backend/package.json backend/
COPY backend/tsconfig.json backend/

# 国内 npm 镜像加速
ENV npm_config_registry=https://registry.npmmirror.com
ENV pnpm_config_registry=https://registry.npmmirror.com
RUN pnpm install --frozen-lockfile --filter "@blue-whale/backend..."

# 源码 + tsconfig
COPY tsconfig.json tsconfig.base.json ./
COPY packages/contracts packages/contracts
COPY packages/core packages/core
COPY packages/persistence packages/persistence
COPY backend backend

# Prisma client + backend 全量构建（含 generation-worker app）
RUN pnpm --dir packages/persistence exec prisma generate
RUN pnpm --dir backend build

WORKDIR /app/backend
# worker 自带 /ready HTTP 探活（默认 4002，GENERATION_WORKER_PORT 可覆盖）
EXPOSE 4002
CMD ["node", "dist/apps/generation-worker/src/main.js"]
