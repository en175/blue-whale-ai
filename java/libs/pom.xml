<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Java 共享基础设施（ADR-0114）。

    ⚠️ **只放基础设施，不放领域规则。**

    这条是 ADR-0084 从 `blue_whale_server` 退役继承来的教训
    （双份契约漂移、第二套领域规则）：**共享基础设施不会漂移，共享领域规则必然漂移**。
    判断标准：新加一个类时问自己「它认识我们的业务吗」——认识就不该放这。
    反例：`GenerationError`（生成域错误码）、`NewApiErrorClassifier`（依赖前者）都不进来。

    ⚠️ **刻意不继承 spring-boot-starter-parent**：
    本模块是**被依赖方**，继承会把 Spring Boot 的依赖管理强加到所有消费者身上，
    等于用框架版本反过来锁住调用方。需要什么依赖就显式声明什么。

    ⚠️ **不是** Spring Boot 应用：没有启动类、没有 @Configuration 扫描入口。
    消费者自行 @Import 或按需装配。

    当前内容（随 billing 落地按需增长）：
      http/NewApiHttpSupport   调 new-api 的 HTTP 装配（baseUrl 归一化 / OkHttp 构建 / 标准请求头）
  -->
  <groupId>com.bluewhale</groupId>
  <artifactId>bluewhale-java-libs</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>bluewhale-java-libs</name>
  <description>Java 侧共享基础设施：只放 DB/MQ/HTTP/错误体系，不放领域规则。</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- 与 worker 保持一致；两边各自声明而非继承，避免被依赖方反向锁版本 -->
    <okhttp.version>4.12.0</okhttp.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp</artifactId>
      <version>${okhttp.version}</version>
    </dependency>
  </dependencies>
</project>
