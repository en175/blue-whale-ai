#!/usr/bin/env bash
# pre-commit hook — Blue-Whale
# 纯 shell，零依赖。功能：
#   1. 禁提交生成物（dist/ target/ .next/ __pycache__/ node_modules/ 等；graphify-out/ 团队图谱除外）
#   2. 后端改动时跑 py_compile（软提醒，不拦提交）
#   3. 远程落后软提醒（工单分支落后 origin/master）
#   4. 错误码改码注释对账（staged 含 error-codes.ts 时；无 node 环境跳过）
# 退出码非 0 = 拦截提交。

set -uo pipefail

_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

# 只检查本次暂存（staged）的文件
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

# ============================================================
# 1. 禁提交生成物
# ============================================================
ban_patterns=(
  'graphify-out/cache/'
  'graphify-out/cost.json'
  '/dist/'
  'dist-ssr/'
  '/target/'
  '/build/'
  '__pycache__/'
  '.next/'
  'node_modules/'
)

block_hit=""
for pat in "${ban_patterns[@]}"; do
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    # 路径含生成物目录即拦
    if [[ "/$f/" == *"$pat"* ]]; then
      block_hit="${block_hit}  $f\n"
    fi
  done <<< "$staged_files"
done

if [ -n "$block_hit" ]; then
  echo "❌ pre-commit: 检测到生成物/构建产物被提交，已拦截：" >&2
  printf "%b" "$block_hit" >&2
  echo "" >&2
  echo "这些是自动生成或本地文件，不应进仓。详见 .gitignore 与 docs/agents/commit-and-review.md。" >&2
  echo "如确需提交，请从暂存区移除：git restore --staged <文件>" >&2
  exit 1
fi

# ============================================================
# 2. 远程落后软提醒（触发式同步——落后 origin/master 时提醒，不拦 commit）
#    职责：commit 前告知分支落后状态，让 rebase 冲突早冒、小颗粒。
#    不拦 commit 或 push；创建/更新 PR 前由发布入口要求同步。
#    仅工单分支生效。见 docs/adr/0006-sync-mechanism-auto-block.md。
# ============================================================
git fetch origin master >/dev/null 2>&1 || true   # 静默 fetch，失败放行
_upstream=$(git rev-parse --verify --quiet refs/remotes/origin/master 2>/dev/null || true)
case "$_branch" in
  feature/*|fix/*|hotfix/*|docs/*|chore*)
    # 本地 HEAD 是否已包含 origin/master 最新？不是祖先 = 落后
    if [ -n "$_upstream" ] && ! git merge-base --is-ancestor "$_upstream" HEAD 2>/dev/null; then
      _behind=$(git rev-list --count HEAD.."$_upstream" 2>/dev/null || echo "?")
      echo "⚠️  pre-commit: ${_branch} 落后 origin/master 约 ${_behind} 个提交（软提醒，不拦 commit）。" >&2
      echo "    冲突会越攒越大 → 建议尽快运行 scripts/sync-task-from-origin.sh sync --json" >&2
      echo "    创建或更新 PR 前需要同步；可提前运行 scripts/sync-task-from-origin.sh sync --json。" >&2
    fi
    ;;
esac

# ============================================================
# 3. 错误码改码注释对账（staged 含 error-codes.ts 时）
#    改码（让号/迁移）提交必须同步清理旧数值在该错误域的注释与测试名残留
#    （实证：!831 调速 1051→1052 注释漏改约 30 处）。主链路仍纯 shell，
#    仅此节调用 node；无 node 环境时跳过，不破坏零依赖承诺。
# ============================================================
if printf '%s\n' "$staged_files" | grep -qx 'backend/libs/contracts/error-codes.ts' && command -v node >/dev/null 2>&1; then
  node scripts/check-error-code-drift.mjs || exit 1
fi

exit 0
