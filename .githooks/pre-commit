#!/usr/bin/env bash
# pre-commit hook — Blue-Whale
# 纯 shell，零依赖。功能：
#   1. 禁提交生成物（dist/ target/ .next/ __pycache__/ node_modules/ 等；graphify-out/ 团队图谱除外）
#   2. 前端改动时跑 lint-staged（prettier --write + eslint --fix），lint error 不可修时硬拦
#   3. 前端改动全量 lint 兜底软提醒（不拦提交）
#   4. 后端改动时跑 py_compile（软提醒，不拦提交）
#   5. 远程落后软提醒（工单分支落后 origin/master）
# 退出码非 0 = 拦截提交。

set -uo pipefail

_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

# 只检查本次暂存（staged）的文件
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

# ============================================================
# 1. 禁提交生成物
# ============================================================
ban_patterns=(
  'graphify-out/cache/'
  'graphify-out/cost.json'
  '/dist/'
  'dist-ssr/'
  '/target/'
  '/build/'
  '__pycache__/'
  '.next/'
  'node_modules/'
)

block_hit=""
for pat in "${ban_patterns[@]}"; do
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    # 路径含生成物目录即拦
    if [[ "/$f/" == *"$pat"* ]]; then
      block_hit="${block_hit}  $f\n"
    fi
  done <<< "$staged_files"
done

if [ -n "$block_hit" ]; then
  echo "❌ pre-commit: 检测到生成物/构建产物被提交，已拦截：" >&2
  printf "%b" "$block_hit" >&2
  echo "" >&2
  echo "这些是自动生成或本地文件，不应进仓。详见 .gitignore 与 docs/agents/commit-and-review.md。" >&2
  echo "如确需提交，请从暂存区移除：git restore --staged <文件>" >&2
  exit 1
fi

# ============================================================
# 2. 前端改动 → lint-staged 自动修（prettier + eslint --fix）
#    仅处理本次暂存的 blue_whale_web/ 文件，限定模块范围避免误改后端/scripts。
#    失败（lint error 无法自动修）→ 硬拦；要求修复后再 commit。
#    紧接着的 npm run lint 兜底跑全量 lint，发现累积 warning 时软提醒。
# ============================================================
if grep -q '^blue_whale_web/' <<< "$staged_files"; then
  # 前置检查：lint-staged 是否可用（node_modules 存在且有可执行文件）
  if [ -x "blue_whale_web/node_modules/.bin/lint-staged" ]; then
    echo "ℹ️  pre-commit: 检测到前端改动，跑 lint-staged（prettier --write + eslint --fix）..." >&2
    # 在 worktree 根跑 lint-staged（不在 blue_whale_web 子目录跑）—— lint-staged 从 cwd 解析 git root，
    # 子目录跑会"could not find any staged files matching configured tasks"。npm CLI --prefix 让命令
    # 复用 blue_whale_web/node_modules，但 cwd 仍是 git root。
    _lint_log=$(mktemp 2>/dev/null || echo "$(pwd)/.lint-staged.log")
    if ! npx --no --prefix blue_whale_web --no-install lint-staged >"$_lint_log" 2>&1; then
      echo "❌ pre-commit: lint-staged 失败（lint error 无法自动修或 formatter 异常）。已拦截提交。" >&2
      echo "--- lint-staged 输出 ---" >&2
      cat "$_lint_log" >&2
      echo "--- 修复后再 commit。可手动跑 npm run format && npm run lint 看具体错误。 ---" >&2
      rm -f "$_lint_log"
      exit 1
    fi
    rm -f "$_lint_log"
    echo "✅ lint-staged 通过" >&2

    echo "ℹ️  pre-commit: 跑 npm run lint（兜底软提醒，不拦截）..." >&2
    if ! (cd blue_whale_web && npm run lint) >/dev/null 2>&1; then
      echo "⚠️  pre-commit: lint 有错误。本次不拦截，请判断是否需修复。注意：警告也请查看 stderr。⚠️" >&2
    else
      echo "✅ lint 通过" >&2
    fi
  else
    echo "⚠️  pre-commit: blue_whale_web/node_modules 未安装，跳过 lint-staged（非阻塞）。" >&2
    echo "    如需 lint 检查，请先执行：cd blue_whale_web && npm install" >&2
  fi
fi

# ============================================================
# 3. 后端语法检查（软提醒，不拦提交；仅当本次改了 blue_whale_server/ 下 .py）
#    用 python -m py_compile 做轻量语法检查（等价于"只 compile 不跑测试"）。
# ============================================================
if grep -q '^blue_whale_server/.*\.py$' <<< "$staged_files"; then
  echo "ℹ️  pre-commit: 检测到后端 Python 改动，运行 py_compile（软提醒，不拦截）..." >&2
  fail=0
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if ! python3 -m py_compile "$f" 2>/dev/null; then
      echo "⚠️  pre-commit: $f 语法检查失败。本次不拦截，请判断是否需修复。" >&2
      fail=1
    fi
  done <<< "$(printf '%s\n' "$staged_files" | grep '^blue_whale_server/.*\.py$')"
  [ "$fail" -eq 0 ] && echo "✅ 后端语法检查通过" >&2
fi

# ============================================================
# 4. 远程落后软提醒（触发式同步——落后 origin/master 时提醒，不拦 commit）
#    职责：commit 前告知分支落后状态，让 rebase 冲突早冒、小颗粒。
#    不拦 commit（存档行为不被远程状态打断）；硬拦在 pre-push（出口铁闸）。
#    仅工单分支生效。见 docs/adr/0006-sync-mechanism-auto-block.md。
# ============================================================
git fetch origin master >/dev/null 2>&1 || true   # 静默 fetch，失败放行
_upstream=$(git rev-parse --verify --quiet refs/remotes/origin/master 2>/dev/null || true)
case "$_branch" in
  feature/*|fix/*|hotfix/*|docs/*|chore*)
    # 本地 HEAD 是否已包含 origin/master 最新？不是祖先 = 落后
    if [ -n "$_upstream" ] && ! git merge-base --is-ancestor "$_upstream" HEAD 2>/dev/null; then
      _behind=$(git rev-list --count HEAD.."$_upstream" 2>/dev/null || echo "?")
      echo "⚠️  pre-commit: ${_branch} 落后 origin/master 约 ${_behind} 个提交（软提醒，不拦 commit）。" >&2
      echo "    冲突会越攒越大 → 建议尽快运行 scripts/sync-task-from-origin.sh sync --json" >&2
      echo "    push 时 pre-push 仍会硬拦（铁闸）。见 docs/adr/0006-sync-mechanism-auto-block.md。" >&2
    fi
    ;;
esac

exit 0
