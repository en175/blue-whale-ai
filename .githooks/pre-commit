#!/usr/bin/env bash

set -uo pipefail

_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

ban_patterns=(
  'graphify-out/cache/'
  'graphify-out/cost.json'
  '/dist/'
  'dist-ssr/'
  '/target/'
  '/build/'
  '__pycache__/'
  '.next/'
  'node_modules/'
)

block_hit=""
for pat in "${ban_patterns[@]}"; do
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if [[ "/$f/" == *"$pat"* ]]; then
      block_hit="${block_hit}  $f\n"
    fi
  done <<< "$staged_files"
done

if [ -n "$block_hit" ]; then
  echo "❌ pre-commit: 检测到生成物/构建产物被提交，已拦截：" >&2
  printf "%b" "$block_hit" >&2
  echo "" >&2
  echo "这些是自动生成或本地文件，不应进仓。详见 .gitignore 与 docs/agents/commit-and-review.md。" >&2
  echo "如确需提交，请从暂存区移除：git restore --staged <文件>" >&2
  exit 1
fi

case "$_branch" in
  feature/*|fix/*|hotfix/*|docs/*|chore/*)
    _root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    _target=$(python3 "$_root/scripts/lib/task_metadata.py" read --field target_branch 2>/dev/null || true)
    if [ -z "$_target" ]; then
      echo "⚠️  pre-commit: 缺少任务发布线元数据；提交可继续，验证和发布前须显式修复。" >&2
    else
      _upstream=$(git rev-parse --verify --quiet "refs/remotes/origin/$_target" 2>/dev/null || true)
      if [ -n "$_upstream" ] && ! git merge-base --is-ancestor "$_upstream" HEAD 2>/dev/null; then
        _behind=$(git rev-list --count HEAD.."$_upstream" 2>/dev/null || echo "?")
        echo "⚠️  pre-commit: ${_branch} 落后 origin/${_target} 约 ${_behind} 个提交（本机引用，软提醒）。" >&2
        echo "    创建或更新 PR 前运行 scripts/sync-task-from-origin.sh sync --target-branch ${_target} --json。" >&2
      fi
    fi
    ;;
esac

if printf '%s\n' "$staged_files" | grep -qx 'backend/libs/contracts/error-codes.ts' && command -v node >/dev/null 2>&1; then
  node scripts/check-error-code-drift.mjs || exit 1
fi

if printf '%s\n' "$staged_files" | grep -q '^contracts/proto/'; then
  bash scripts/check-contract-breaking.sh
  _contract_rc=$?
  [ "$_contract_rc" -eq 1 ] && exit 1
fi

_comment_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$_comment_root/scripts/lib/python3-command.sh"
if ! select_python3_command; then
  echo "pre-commit: 缺少 Python 3，无法检查新增代码注释，提交已阻断。" >&2
  exit 1
fi
"${PYTHON3_COMMAND[@]}" "$_comment_root/scripts/check-code-comments.py" --staged || exit 1

exit 0
