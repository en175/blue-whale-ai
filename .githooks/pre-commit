#!/usr/bin/env bash
# pre-commit hook — Blue-Whale
# 纯 shell，零依赖。功能：
#   1. 禁提交生成物（dist/ target/ .next/ __pycache__/ node_modules/ 等；graphify-out/ 团队图谱除外）
#   2. 远程落后软提醒（按任务元数据中的目标 release）
# 退出码非 0 = 拦截提交。

set -uo pipefail

_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

# 只检查本次暂存（staged）的文件
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

# ============================================================
# 1. 禁提交生成物
# ============================================================
ban_patterns=(
  'graphify-out/cache/'
  'graphify-out/cost.json'
  '/dist/'
  'dist-ssr/'
  '/target/'
  '/build/'
  '__pycache__/'
  '.next/'
  'node_modules/'
)

block_hit=""
for pat in "${ban_patterns[@]}"; do
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    # 路径含生成物目录即拦
    if [[ "/$f/" == *"$pat"* ]]; then
      block_hit="${block_hit}  $f\n"
    fi
  done <<< "$staged_files"
done

if [ -n "$block_hit" ]; then
  echo "❌ pre-commit: 检测到生成物/构建产物被提交，已拦截：" >&2
  printf "%b" "$block_hit" >&2
  echo "" >&2
  echo "这些是自动生成或本地文件，不应进仓。详见 .gitignore 与 docs/agents/commit-and-review.md。" >&2
  echo "如确需提交，请从暂存区移除：git restore --staged <文件>" >&2
  exit 1
fi

# ============================================================
# 2. 远程落后软提醒（使用本机已有远端引用，不执行 fetch）
#    职责：commit 前告知分支落后状态，让 rebase 冲突早冒、小颗粒。
#    不拦 commit 或 push；创建/更新 PR 前由发布入口要求同步。
#    仅工单分支生效。见 docs/adr/0006-sync-mechanism-auto-block.md。
# ============================================================
case "$_branch" in
  feature/*|fix/*|hotfix/*|docs/*|chore/*)
    _root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    _target=$(python3 "$_root/scripts/lib/task_metadata.py" read --field target_branch 2>/dev/null || true)
    if [ -z "$_target" ]; then
      echo "⚠️  pre-commit: 缺少任务发布线元数据；提交可继续，验证和发布前须显式修复。" >&2
    else
      _upstream=$(git rev-parse --verify --quiet "refs/remotes/origin/$_target" 2>/dev/null || true)
      # 本地 HEAD 是否包含已抓取的目标引用？不是祖先 = 落后。
      if [ -n "$_upstream" ] && ! git merge-base --is-ancestor "$_upstream" HEAD 2>/dev/null; then
        _behind=$(git rev-list --count HEAD.."$_upstream" 2>/dev/null || echo "?")
        echo "⚠️  pre-commit: ${_branch} 落后 origin/${_target} 约 ${_behind} 个提交（本机引用，软提醒）。" >&2
        echo "    创建或更新 PR 前运行 scripts/sync-task-from-origin.sh sync --target-branch ${_target} --json。" >&2
      fi
    fi
    ;;
esac

exit 0
