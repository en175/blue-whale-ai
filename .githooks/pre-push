#!/usr/bin/env bash

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

if command -v python3 >/dev/null 2>&1; then
  validator=(python3 "$ROOT/scripts/start-task-worktree.py")
elif command -v py >/dev/null 2>&1; then
  validator=(py -3 "$ROOT/scripts/start-task-worktree.py")
else
  echo "❌ pre-push: 未找到 Python 3，无法验证结构化中文分支名。" >&2
  exit 1
fi


blocked=0
reason=""
invalid_name=0
direct_master=0

while read -r local_ref local_sha remote_ref remote_sha; do
  remote_sha=${remote_sha%$'\r'}
  case "$remote_ref" in
    refs/heads/master|refs/heads/main|refs/heads/dev|refs/heads/test|refs/heads/release)
      blocked=1
      direct_master=1
      reason="${reason}  直推 ${remote_ref#refs/heads/}：禁本地 push 保护分支\n"
      continue
      ;;
  esac

  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac

  case "$remote_ref" in
    refs/heads/*) branch=${remote_ref#refs/heads/} ;;
    *) continue ;;
  esac

  if ! "${validator[@]}" --validate-branch "$branch" >/dev/null 2>&1; then
    case "$remote_sha" in
      0000000000000000000000000000000000000000)
        blocked=1
        invalid_name=1
        reason="${reason}  ${branch}：结构化中文分支名不合规\n"
        continue
        ;;
      *)
        printf '⚠️ pre-push: 存量远程分支 %s 使用旧命名，本次兼容放行。\n' "$branch" >&2
        ;;
    esac
  fi

  case "$remote_ref:$remote_sha" in
    refs/heads/release/*:0000000000000000000000000000000000000000)
      production_sha="$(git ls-remote --heads origin refs/heads/master | cut -f1)"
      if [ -n "$production_sha" ] && [ "$local_sha" = "$production_sha" ]; then
        continue
      fi
      ;;
  esac

  if ! node "$ROOT/scripts/verify-change-scope.mjs" check-push --head "$local_sha" </dev/null; then
    blocked=1
    reason="${reason}  ${branch}：前端构建凭证缺失、失败或已失效\\n"
  fi
done

if [ "$blocked" -ne 0 ]; then
  if [ "$direct_master" -ne 0 ]; then
    cat >&2 <<EOF
❌ pre-push: 禁止直推或删除 master/main/dev/test/release（已拦截）。
`printf '%b' "$reason"`

这五条分支只接受 PR 合入，合并只在 Gitee 服务端进行：

  git checkout -b <分支名>          # 开工单分支（feature/fix/hotfix/docs/chore，见 docs/agents/branch-naming.md）
  git push -u origin <分支名>        # 推分支
  # → Gitee 建 PR → 服务端合并（低风险可 MCP merge_pull 自审合）

"自审合"只免互审，不免流程。详见 CLAUDE.md「提交与审查」红线
与 docs/adr/0003-no-direct-push-to-master.md、docs/adr/0133-environment-branches.md。
EOF
  elif [ "$invalid_name" -ne 0 ]; then
    cat >&2 <<EOF
❌ pre-push: 分支名不符合结构化中文规范，已拦截。
`printf '%b' "$reason"`

请通过唯一入口创建任务分支：

  scripts/start-task-worktree.sh --type fix --issue IK094T --summary 修复工作树写入护栏
  scripts/start-task-worktree.sh --type chore --no-issue --summary 完善工作树启动流程

完整规则见 docs/agents/branch-naming.md。
EOF
  else
    printf 'pre-push: 推送验证未通过，已拦截。\n%b\n先运行 node scripts/verify-change-scope.mjs run --stage pr，再重新推送。\n' "$reason" >&2
  fi
  exit 1
fi

exit 0
