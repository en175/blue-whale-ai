#!/usr/bin/env bash

set -u

msg_file="$1"

first_line=$(grep -v '^#' "$msg_file" | sed '/^\s*$/d' | head -n 1)

types_re='^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert)(\([^)]+\))?!?: .+'

if ! [[ "$first_line" =~ $types_re ]]; then
  echo "❌ commit-msg: 不符合 Conventional Commits 规范" >&2
  echo "" >&2
  echo "  第一行: $first_line" >&2
  echo "" >&2
  echo "  要求格式: <type>: <描述>  或  <type>(<scope>): <描述>" >&2
  echo "  合法 type: feat / fix / docs / refactor / chore / style / test / perf / build / ci / revert" >&2
  echo "  示例: feat: 新增画布节点批量导出" >&2
  echo "        fix(chat): 修复消息列表滚动" >&2
  exit 1
fi

exit 0
