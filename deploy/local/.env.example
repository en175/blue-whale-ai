# Blue-Whale 本地 MVP 环境变量样例（IK1NRX）
#
# 用法：cp .env.example .env，按需修改后 scripts/local-mvp.sh up
# 所有值都已是可用的本地默认占位；切勿填入真实生产凭据，本文件不入库真实密钥。

# ===== JWT =====
# gateway 与 user-service 共用同一 secret 才能验签；至少 32 字节
JWT_SECRET=blue-whale-dev-secret-key-at-least-256-bits!!

# ===== MySQL =====
MYSQL_DB=blue_whale
MYSQL_PASSWORD=blue_whale
# 宿主机发布端口（避免与本地已装 MySQL 冲突时改此值）
MYSQL_PUBLISH_PORT=3306

# ===== Redis =====
REDIS_PUBLISH_PORT=6379

# ===== Nacos =====
NACOS_PUBLISH_PORT=8848

# ===== 业务服务发布端口 =====
WEB_PUBLISH_PORT=3000
GATEWAY_PUBLISH_PORT=8686
USER_PUBLISH_PORT=8081
AGENT_PUBLISH_PORT=8082

# ===== 测试登录 =====
# 测试手机号 15079999999（AuthService 硬编码 TEST_PHONE）：任意验证码通过、自动注册
# 访问 http://localhost:3000 → 手机号填 15079999999 → 验证码填任意 6 位 → 登录

# ===== 受控真实图片验收（IK1NS3，默认关闭）=====
# 以下各项保持注释即维持默认 Fake Provider，普通 CI 不需要也不会持有真实凭据。
# 启用步骤、预期产品事实与证据模板见 deploy/local/acceptance/README.md。
# 真实凭据只填在本地 .env（gitignore），绝不入库；缺失或无效时启动即失败，不回退。
# GENERATION_MODE=openai-tos
# GENERATION_ACCEPTANCE_ALLOWED=true
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# GENERATION_TOS_ACCESS_KEY=
# GENERATION_TOS_SECRET_KEY=
# GENERATION_TOS_REGION=
# GENERATION_TOS_ENDPOINT=
# GENERATION_TOS_BUCKET=
# GENERATION_TOS_PREFIX=generation-acceptance
# SEEDANCE_CALLBACK_BASE_URL=https://callback.invalid/acceptance-placeholder

# ===== 火山方舟 Agent Plan 真实文生图（IK21O4，默认关闭）=====
# 默认维持 Fake 编排与 Fake 生图（GENERATION_MODE=fake），普通 CI 不持有真实凭据。
# 启用真图：取消下面注释、GENERATION_MODE 改 agent-plan 并填入 Agent Plan 专属 API Key。
# ARK_BASE_URL 默认指向 Agent Plan 专属 /api/plan/v3 端点，混用标准 /api/v3 会失败或产生额外费用。
# 真实 Key 只填本地 .env（gitignore），绝不入库；缺失时启动 fail-closed 报配置缺失，不回退。
# GENERATION_MODE=agent-plan
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
