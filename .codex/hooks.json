{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" block-master-edit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" block-dangerous-git.sh"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" block-push-to-master.sh"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" confirm-release-action.sh"
          }
        ]
      },
      {
        "matcher": "mcp__gitee-ent__create_enterprise_repo_pull",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" confirm-release-action.sh"
          }
        ]
      },
      {
        "matcher": "mcp__gitee-ent__merge_enterprise_pull",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" confirm-release-action.sh"
          }
        ]
      },
      {
        "matcher": "mcp__gitee-ent__create_enterprise_repo_release",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" confirm-release-action.sh"
          }
        ]
      },
      {
        "matcher": "mcp__gitee-ent__create_enterprise_issue",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" block-issue-without-repo.sh"
          }
        ]
      },
      {
        "matcher": "mcp__gitee-ent__update_enterprise_issue",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" block-issue-without-repo.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Grep|Glob|exec_command|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" cbm-discovery-gate.sh"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" block-gitee-alternative-channel.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" remind-issue-state.sh"
          }
        ]
      },
      {
        "matcher": "mcp__gitee-ent__create_enterprise_repo_pull",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" confirm-release-action.sh"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" remind-issue-state.sh"
          }
        ]
      },
      {
        "matcher": "mcp__gitee-ent__merge_enterprise_pull",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" confirm-release-action.sh"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" remind-issue-state.sh"
          }
        ]
      },
      {
        "matcher": "mcp__gitee-ent__create_enterprise_repo_release",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" confirm-release-action.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" cbm-session-reminder.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "PONYTAIL_CLIENT=codex PONYTAIL_PROJECT_DIR=\"$(git rev-parse --show-toplevel)\" node \"$(git rev-parse --show-toplevel)/.claude/hooks/ponytail-activate.js\"",
            "timeout": 5,
            "additionalContextLimit": 6000
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run-claude-pretool.sh\" cbm-session-reminder.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "PONYTAIL_CLIENT=codex PONYTAIL_PROJECT_DIR=\"$(git rev-parse --show-toplevel)\" node \"$(git rev-parse --show-toplevel)/.claude/hooks/ponytail-subagent.js\"",
            "timeout": 5,
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PONYTAIL_CLIENT=codex PONYTAIL_PROJECT_DIR=\"$(git rev-parse --show-toplevel)\" node \"$(git rev-parse --show-toplevel)/.claude/hooks/ponytail-mode-tracker.js\"",
            "timeout": 5,
            "additionalContextLimit": 6000
          }
        ]
      }
    ]
  }
}
