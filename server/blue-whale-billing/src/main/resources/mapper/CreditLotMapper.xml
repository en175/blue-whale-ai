<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  积分批次的复杂语句。

  落位约定（全模块统一）：带 ORDER BY / LIMIT / FOR UPDATE / 聚合 / 自引用表达式的语句写在
  XML；纯等值或比较谓词的单表读写用 LambdaQueryWrapper，不在这里重复一遍样板。
-->
<mapper namespace="com.bluewhale.billing.adapter.outbound.persistence.mapper.CreditLotMapper">

  <!--
    ★ 锁该用户的全部有效批次，按扣减顺序排好序返回（《计费逻辑详细设计》§4.1）。

    三级 tie-break：
      ① (expires_at IS NULL)   永久排最后
      ① expires_at ASC         先过期先扣
      ② source_priority ASC    同到期时间按来源（先消耗平台赠送的）
      ③ id ASC                 先获得的先扣

    ⚠️ source_priority 是**冗余列**而非 FIELD(source, 'compensation','bonus',...)：
       后者把优先级硬编码进 SQL，枚举一改就静默错位；前者由插入时决定且能走索引。

    ⚠️ ORDER BY 第一项是布尔表达式——MySQL 里 (expires_at IS NULL) 取 0/1，
       所以 NULL（永久）排在非 NULL 之后，正好是「永久最后扣」。

    只用 FOR UPDATE 锁**单个用户**的行，不是全表：争用范围天然是单用户
    （同一用户的并发提交是个位数，业务语义上本就该串行）。
    对比 GeekAI 的全局 sync.Mutex——那是把「同用户串行」做成了「全库串行」。

    过期批次靠 WHERE 天然排除，不需要定时任务清理（行不删，见 expireLot）。
  -->
  <select id="lockActiveLots" resultType="com.bluewhale.billing.adapter.outbound.persistence.entity.CreditLotEntity">
    SELECT id, user_id, source, source_priority, amount, remaining, frozen, expires_at, biz_type, biz_id, version
    FROM billing_credit_lots
    WHERE user_id = #{userId}
      AND (expires_at IS NULL OR expires_at > NOW())
    ORDER BY (expires_at IS NULL), expires_at ASC, source_priority ASC, id ASC
    FOR UPDATE
  </select>

  <!--
    可用余额 = Σ(remaining − frozen)，仅计未过期的批次。

    这是**聚合表达式**，Wrapper 的 select 只能列字段名，表达不了 remaining - frozen。
  -->
  <select id="sumAvailable" resultType="long">
    SELECT COALESCE(SUM(remaining - frozen), 0)
    FROM billing_credit_lots
    WHERE user_id = #{userId}
      AND (expires_at IS NULL OR expires_at > NOW())
  </select>

  <!--
    可用余额按来源拆开（用户界面「总积分 = 各类型之和」的数据源）。

    ⚠️ **WHERE 与上面的 sumAvailable 逐字相同**，只多一个 GROUP BY —— 这不是巧合，
       是「Σ 分项 == 总额」那条等式赖以成立的东西。两处谓词一旦分叉，
       界面上就会出现一个凑不出来的总数，而且不报错。要改就两处一起改。
  -->
  <select id="sumAvailableBySource" resultType="com.bluewhale.billing.adapter.outbound.persistence.row.SourceAvailableRow">
    SELECT source, COALESCE(SUM(remaining - frozen), 0) AS credits
    FROM billing_credit_lots
    WHERE user_id = #{userId}
      AND (expires_at IS NULL OR expires_at > NOW())
    GROUP BY source
  </select>

  <!--
    ★ 已到期、仍有可核销量的批次（过期核销任务用）。

    三个条件：
      expires_at IS NOT NULL     NULL = 永久，永不核销
      expires_at <= NOW()        「已到期」是核销的唯一依据——**不做提前核销**
      remaining > frozen         可核销量为 0 的批次不必取（全部冻结的不销，见下）

    ⚠️ 本语句是**全表范围**的，与上面两条「按 user_id」的取数不是一回事：
       核销是平台按批次推的动作，逐用户分片只会把同一件事拆成 N 次扫描。
       走 idx_lots__expires_at（见 V10 迁移）：区间扫描 + 顺序取数，
       NULL（永久）不在任何区间里、天然被跳过；没有这个索引就是全表扫 + 文件排序。

    ⚠️ 冻结部分不过期（§10 决策 7：预扣锁定的 frozen 不受过期影响）：
       核销量是 remaining − frozen，故筛选用 `remaining > frozen` 而不是 `remaining > 0`。
       一个批次的 frozen 被解冻回可用之后（任务失败返还），它会**再次**进入本窗口——
       这正是核销幂等键必须带上批次版本号的原因（见 CreditService.expireLot）。

    ORDER BY expires_at ASC：先到期的先销，与扣减顺序同一取向；也保证 LIMIT 截断时
    丢掉的是较晚到期的那些，不会让某个批次永远排在后面取不到。
  -->
  <select id="listDueLots" resultType="com.bluewhale.billing.adapter.outbound.persistence.entity.CreditLotEntity">
    SELECT id, user_id, source, source_priority, amount, remaining, frozen, expires_at, biz_type, biz_id, version
    FROM billing_credit_lots
    WHERE expires_at IS NOT NULL
      AND expires_at &lt;= NOW()
      AND remaining > frozen
    ORDER BY expires_at ASC
    LIMIT #{limit}
  </select>

  <!--
    按主键读一行并**锁住它**。

    核销的金额由读到的 remaining − frozen 算出，读与写之间必须没有别的写入者——
    否则「销掉多少」在前一条语句里算好、后一条语句里扣掉时已经不再成立。
    FOR UPDATE 是当前读：并发的 hold / settle / 返还都会阻塞到本事务提交，
    而它们各自也会先拿这一行的锁（lockActiveLots 或直接 UPDATE），
    所以「读到什么就销掉什么」在这里成立。
  -->
  <select id="lockById" resultType="com.bluewhale.billing.adapter.outbound.persistence.entity.CreditLotEntity">
    SELECT id, user_id, source, source_priority, amount, remaining, frozen, expires_at, biz_type, biz_id, version
    FROM billing_credit_lots
    WHERE id = #{lotId}
    FOR UPDATE
  </select>

  <!--
    临期批次：前端展示「X 积分将于 Y 日过期」用。

    三个条件各有理由：
      expires_at > NOW()      已过期的不用提醒（它们已经用不上了，提醒也没用）
      remaining > frozen      可用量为 0 的批次不必提醒——提醒一个「0 积分过期」只是噪音
      expires_at <= 窗口      太远的别提示，否则用户天天看到「一年后过期 500 分」

    按到期时间从近到远 + LIMIT：先到期的先提示（扣减顺序也是先扣它们）。
  -->
  <select id="listExpiring" resultType="com.bluewhale.billing.adapter.outbound.persistence.entity.CreditLotEntity">
    SELECT id, user_id, source, amount, remaining, frozen, expires_at, version
    FROM billing_credit_lots
    WHERE user_id = #{userId}
      AND expires_at IS NOT NULL
      AND expires_at > NOW()
      AND expires_at &lt;= DATE_ADD(NOW(), INTERVAL #{withinDays} DAY)
      AND remaining > frozen
    ORDER BY expires_at ASC
    LIMIT #{limit}
  </select>

  <!--
    冻结：预扣用。**只动 frozen**，remaining 不动 —— 钱还没花掉，只是不能用了。

    SET frozen = frozen + #{amount} 是**自引用表达式**：Wrapper 的 set 只能赋常量，
    所以这类语句一律落在 XML，顺带也就不必在 Java 里拼 SQL 片段。
    下面的 releaseFrozen / settle 同理。
  -->
  <update id="addFrozen">
    UPDATE billing_credit_lots
    SET frozen = frozen + #{amount},
        version = version + 1
    WHERE id = #{lotId}
  </update>

  <!--
    解冻：返还用。**只动 frozen**，也不新建批次。

    ⚠️ 刻意不动 remaining：若改成「先扣掉、返还时新建批次」，返还的积分会带**新的有效期**，
    用户凭空获得一次有效期重置，与应得权益不符。
  -->
  <update id="releaseFrozen">
    UPDATE billing_credit_lots
    SET frozen = frozen - #{amount},
        version = version + 1
    WHERE id = #{lotId}
  </update>

  <!--
    结算：解冻并实扣。

    frozenTake 是预扣时锁定的量，actualTake 是实际消耗的量。两者可以不等
    （部分成功 / 缓存命中）——差额自动回到可用余额。

    两列同时按不同数量更新，且都是自引用表达式，Wrapper 表达不了。
  -->
  <update id="settle">
    UPDATE billing_credit_lots
    SET frozen = frozen - #{frozenTake},
        remaining = remaining - #{actualTake},
        version = version + 1
    WHERE id = #{lotId}
  </update>

  <!--
    核销：把已到期的可用量从 remaining 里扣掉。**frozen 原封不动**。

    语义上等价于「这批积分作废了」，所以 remaining 必须跟着降：
    批次表是余额的唯一权威，只写账本分录不改批次，会让每日自检钉的
    Σ lots.remaining == ledger(wallet) + ledger(frozen) 当场差一个「已核销额」。

    ⚠️ 为什么是 `remaining = remaining - #{amount}` 而不是 `remaining = frozen`：
       两者在调用方按 lockById 读到的快照上等价（amount = remaining − frozen），
       但写成自引用减法时，「扣掉的数」与账本那条 expire 分录的金额来自**同一个变量**，
       由调用方算一次；写成 `= frozen` 则是让 SQL 自己再算一次差额——
       两条路径各自算一次，迟早有一天算得不一样，而差额会静默留在批次里。

    ⚠️ 冻结部分不过期（§10 决策 7）：任务在途时预扣锁住的 frozen 不受过期影响，
       这样它仍能结算成功（用户为已经发生的生成付费），失败返还时钱回到可用余额，
       由**下一轮**核销带走（幂等键带版本号，见 CreditService.expireLot）。
  -->
  <update id="expireLot">
    UPDATE billing_credit_lots
    SET remaining = remaining - #{amount},
        version = version + 1
    WHERE id = #{lotId}
  </update>

</mapper>
