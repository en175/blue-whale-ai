{
  "bundle_version_id": "director_v1_0_0",
  "source_agent_definition_id": "director_agent",
  "version": "1.0.0",
  "composition": {
    "roleDocumentId": "role_director",
    "rootRuntimeSkillId": "skill_director_workflow",
    "ruleSet": {
      "rules": [
        "rule_natural_confirmation",
        "rule_progressive_disclosure",
        "rule_conversation_canvas_facts",
        "rule_output_boundary"
      ]
    },
    "modelProfiles": [
      {
        "modelProfileId": "model_canvas",
        "version": "1.0.0",
        "modelKey": "doubao-seed-1-6",
        "capabilities": ["text", "vision", "tool_calling"],
        "maxInputTokens": 100000,
        "maxOutputTokens": 4096
      }
    ],
    "toolGrants": [
      {
        "toolName": "list_canvas_nodes",
        "registryVersion": 1,
        "effect": "read",
        "proposalOnly": true,
        "argumentSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 200}},
          "additionalProperties": false
        },
        "constraints": {"max_results": 200}
      },
      {
        "toolName": "read_canvas_node",
        "registryVersion": 1,
        "effect": "read",
        "proposalOnly": true,
        "argumentSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {"node_id": {"type": "string", "minLength": 1}},
          "required": ["node_id"],
          "additionalProperties": false
        },
        "constraints": {}
      },
      {
        "toolName": "read_asset",
        "registryVersion": 1,
        "effect": "read",
        "proposalOnly": true,
        "argumentSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {"asset_id": {"type": "integer", "minimum": 1}},
          "required": ["asset_id"],
          "additionalProperties": false
        },
        "constraints": {}
      },
      {
        "toolName": "read_generation_job_status",
        "registryVersion": 1,
        "effect": "read",
        "proposalOnly": true,
        "argumentSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {"job_id": {"type": "integer", "minimum": 1}},
          "required": ["job_id"],
          "additionalProperties": false
        },
        "constraints": {}
      },
      {
        "toolName": "list_creative_skills",
        "registryVersion": 1,
        "effect": "read",
        "proposalOnly": true,
        "argumentSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false
        },
        "constraints": {}
      },
      {
        "toolName": "read_conversation_summary",
        "registryVersion": 1,
        "effect": "read",
        "proposalOnly": true,
        "argumentSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false
        },
        "constraints": {}
      },
      {
        "toolName": "read_conversation_history",
        "registryVersion": 1,
        "effect": "read",
        "proposalOnly": true,
        "argumentSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "after": {"type": "integer", "minimum": 1},
            "limit": {"type": "integer", "minimum": 1, "maximum": 100}
          },
          "additionalProperties": false
        },
        "constraints": {"limit": {"max": 100}}
      },
      {
        "toolName": "create_image_generation_job",
        "registryVersion": 1,
        "effect": "side_effect",
        "proposalOnly": true,
        "argumentSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "prompt": {"type": "string", "minLength": 1},
            "aspect_ratio": {"type": "string", "enum": ["1:1", "16:9", "9:16", "4:3", "3:4", "2:3", "3:2", "21:9"]},
            "reference_asset_ids": {"type": "array", "maxItems": 4, "items": {"type": "integer", "minimum": 1}},
            "size": {"type": "string"},
            "web_search": {"type": "boolean"}
          },
          "required": ["prompt"],
          "additionalProperties": false
        },
        "constraints": {"expected_output_count": {"min": 1, "max": 1}, "prompt": {"maxLength": 2000}}
      },
      {
        "toolName": "create_video_generation_job",
        "registryVersion": 1,
        "effect": "side_effect",
        "proposalOnly": true,
        "argumentSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "prompt": {"type": "string", "minLength": 1},
            "aspect_ratio": {"type": "string", "enum": ["16:9", "4:3", "1:1", "3:4", "9:16", "21:9"]},
            "resolution": {"type": "string", "enum": ["480p", "720p", "1080p"]},
            "duration": {"type": "integer", "minimum": 4, "maximum": 15},
            "reference_asset_ids": {"type": "array", "maxItems": 1, "items": {"type": "integer", "minimum": 1}}
          },
          "required": ["prompt", "aspect_ratio", "resolution", "duration"],
          "additionalProperties": false
        },
        "constraints": {"expected_output_count": {"min": 1, "max": 1}, "prompt": {"maxLength": 4000}}
      },
      {
        "toolName": "request_user_input",
        "registryVersion": 1,
        "effect": "side_effect",
        "proposalOnly": true,
        "argumentSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "request_type": {"type": "string", "enum": ["creation_clarification"]},
            "question": {"type": "string", "minLength": 1},
            "resume_binding": {"type": "object", "additionalProperties": true}
          },
          "required": ["request_type", "question"],
          "additionalProperties": false
        },
        "constraints": {"question": {"maxLength": 1000}}
      }
    ],
    "tokenBudget": {
      "estimator": "chars_div_4",
      "initialContextMaxTokens": 4000,
      "singleResourceMaxTokens": 3000,
      "activeContextMaxTokens": 16000
    }
  },
  "resources": [
    {
      "resource_id": "role_director",
      "revision": 1,
      "kind": "role_document",
      "path": "AGENTS.md",
      "media_type": "text/markdown",
      "load_mode": "always_on",
      "references": []
    },
    {
      "resource_id": "rule_natural_confirmation",
      "revision": 1,
      "kind": "rule",
      "path": "rules/natural-confirmation.md",
      "media_type": "text/markdown",
      "load_mode": "always_on",
      "conflict_domain": "confirmation",
      "references": []
    },
    {
      "resource_id": "rule_progressive_disclosure",
      "revision": 1,
      "kind": "rule",
      "path": "rules/progressive-disclosure.md",
      "media_type": "text/markdown",
      "load_mode": "always_on",
      "conflict_domain": "disclosure",
      "references": []
    },
    {
      "resource_id": "rule_conversation_canvas_facts",
      "revision": 1,
      "kind": "rule",
      "path": "rules/conversation-canvas-facts.md",
      "media_type": "text/markdown",
      "load_mode": "always_on",
      "conflict_domain": "facts",
      "references": []
    },
    {
      "resource_id": "rule_output_boundary",
      "revision": 1,
      "kind": "rule",
      "path": "rules/output-boundary.md",
      "media_type": "text/markdown",
      "load_mode": "always_on",
      "conflict_domain": "output",
      "references": []
    },
    {
      "resource_id": "skill_director_workflow",
      "revision": 1,
      "kind": "runtime_skill",
      "path": "skills/director-workflow/SKILL.md",
      "media_type": "text/markdown",
      "load_mode": "on_demand",
      "metadata": {
        "name": "director-workflow",
        "description": "创作导演的根工作流：顾问式多轮对话，按用户意图在咨询、澄清、创作方法推荐与生成动作提议之间自主选择。",
        "allow_implicit_invocation": true
      },
      "references": [
        {
          "raw_ref": "../../references/generation-action-guide.md",
          "resolved_resource_id": "ref_generation_action_guide"
        }
      ]
    },
    {
      "resource_id": "ref_generation_action_guide",
      "revision": 1,
      "kind": "reference",
      "path": "references/generation-action-guide.md",
      "media_type": "text/markdown",
      "load_mode": "on_demand",
      "references": []
    }
  ]
}
