!.codex/hooks/
.codex/hooks/*
!.codex/hooks/run-claude-pretool.sh
.codex/config.toml

# Graphify 本地产物，整个不入库（各 worktree / clone 各自生成或共享）
graphify-out/
.codebase-memory/

# 本地运行时产物目录（logs/dist/node_modules，不入库）
blue_whale_api/

# 运行时生成物（asset 转存的 mp4/图片）
data/

# OpenSpec 规划文档（入库共享，规格驱动开发）
openspec-frontend/

# agent 本地参考文档（视频/图片生成 API、todos 等，不入库；注意是 docs/agent 单数，勿与 docs/agents 团队文档混淆）
docs/agent/

# Node / 前端
node_modules/
.next/
.worker-dist/
next-env.d.ts
*.tsbuildinfo

# 本地说明文档（agent 生成的流程说明，不进仓）
docs/skills/Description file/

# Playwright 产物（IJZYVT）
test-results/
playwright-report/
.playwright/
blob-report/
playwright/.cache/


# Java / Maven
target/
*.class

# 环境变量（凭据不入库）
.env

# 运行日志
logs/

# mitmproxy 抓包产物（本地工具，不入库）
mitm_mcp_traffic.db
*.flow
*.flow

# Python 缓存（hook 脚本运行产物）
__pycache__/
*.pyc

# 本地私人配置（kimi CLI 等，勿入库）
.kimi-code/*
!.kimi-code/
