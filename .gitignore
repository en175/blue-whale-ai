.DS_Store

# Editors
.vscode/
.idea/
*.swp

# MCP
.mcp.json

# 本地私人配置（codex CLI 等，勿入库）
.codex/*
!.codex/
!.codex/hooks.json
!.codex/hooks/
.codex/hooks/*
!.codex/hooks/run-claude-pretool.sh
.codex/config.toml
.agents/skills/

# Graphify 本地产物，整个不入库（各 worktree / clone 各自生成或共享）
graphify-out/
.codebase-memory/

# 运行时生成物（asset 转存的 mp4/图片）
data/

# OpenSpec 规划文档（本地工具，不入库）
openspec/

# agent 本地参考文档（视频/图片生成 API、todos 等，不入库；注意是 docs/agent 单数，勿与 docs/agents 团队文档混淆）
docs/agent/

# Node / 前端
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# 本地说明文档（agent 生成的流程说明，不进仓）
blue-whale-agent-workspace/Description file/

# superpowers 本地产物（plans/specs 等，不进仓）
docs/superpowers/
# SDD 运行时 scratch（progress ledger/task reports），不进仓；.superpowers/skills/ 是 tracked 技能文件
.superpowers/sdd/
# Playwright 产物（IJZYVT）
test-results/
playwright-report/
.playwright/
blob-report/
playwright/.cache/

# superpowers 本地产物（plans 等，不进仓）
docs/superpowers/

# Java / Maven
target/
*.class

# Python 构建产物（pip install . / setup.py 生成，不入库）
*.egg-info/
build/
dist/
.eggs/

# Python 字节码缓存与本地虚拟环境（运行/测试生成，不入库）
__pycache__/
*.py[cod]
.venv/

# 运行日志
logs/

# zcode 本地产物（plans 等，不进仓）
.zcode/plans/

# 本地 MVP 实际 env（凭据不入库；deploy/local/.env.example 入库）
deploy/local/.env
